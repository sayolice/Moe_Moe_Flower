  memorialEntries:
  - unlockBondLevel: 1
    title: "\uB2E8\uB2E8\uD788 \uB2EB\uD78C \uAF43\uBD09\uC624\uB9AC"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uD654\uB2E8 \uD55C\uAC00\uC6B4\uB370, \uC720\uB3C5 \uC2DC\uC120\uC744 \uB044\uB294 \uBD89\uC740 \uBD09\uC624\uB9AC\uAC00 \uC788\uC5C8\uB2E4."
    - "[N] \uD558\uC9C0\uB9CC \uBA70\uCE60\uC774 \uC9C0\uB098\uB3C4 \uAF43\uC78E\uC740 \uC870\uAE08\uB3C4 \uBC8C\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    - "[ENTER_C:\uD2A4\uB9BD]"
    - "[C:\uD2A4\uB9BD] \uBB58 \uADF8\uB807\uAC8C \uBE64\uD788 \uBD10?"
    - "[N] \uAE5C\uC9DD \uB180\uB77C \uB4A4\uB85C \uBB3C\uB7EC\uC11C\uC790, \uBD89\uC740 \uBA38\uB9AC\uC758 \uC18C\uB140\uAC00 \uD314\uC9F1\uC744 \uB07C\uBA70 \uB098\uB97C \uC3D8\uC544\uBCF4\uC558\uB2E4."
    - "[C:\uD2A4\uB9BD] \uD765, \uB0B4\uAC00 \uC548 \uD53C\uC5B4\uB098\uB2C8\uAE4C \uC774\uC0C1\uD574?"
    - "[C:\uD2A4\uB9BD] \uB9D0\uD574\uB450\uB294\uB370, \uB09C \uC544\uBB34\uD55C\uD14C\uB098 \uC27D\uAC8C \uAF43\uC78E\uC744 \uC5EC\uB294 \uC2DC\uC2DC\uD55C \uAF43\uC774 \uC544\uB2C8\uAC70\uB4E0?"
    - "[N] \uCF67\uB300\uB97C \uB192\uC774 \uC138\uC6B4 \uCC44, \uC18C\uB140\uB294 \uACE0\uAC1C\uB97C \uD671 \uB3CC\uB838\uB2E4."
    - "[C:\uD2A4\uB9BD] \uD2A4\uB9BD\uC740 \uADC0\uD558\uACE0 \uB3C4\uB3C4\uD55C \uAF43\uC774\uB780 \uB9D0\uC774\uC57C."
    - "[C:\uD2A4\uB9BD] \uD587\uBCD5\uB3C4 \uAC00\uC7A5 \uC88B\uC740 \uC790\uB9AC\uC5D0, \uBB3C\uB3C4 \uC81C\uB54C, \uC0AC\uB791\uB3C4 \uB118\uCE58\uB3C4\uB85D \uB4EC\uBFCD \uC918\uC57C\uB9CC \uD53C\uC5B4\uB09C\uB2E4\uACE0."
    - "[N] \uB098\uB294 \uC870\uC6A9\uD788 \uACC1\uC73C\uB85C \uB2E4\uAC00\uAC00 \uBB34\uB98E\uC744 \uAFC7\uC5C8\uB2E4."
    - "[N] \uBD09\uC624\uB9AC \uC8FC\uBCC0\uC758 \uAD73\uC740 \uD759\uC744 \uBD80\uB4DC\uB7FD\uAC8C \uACE8\uB77C\uC8FC\uACE0, \uC78E\uC0AC\uADC0\uC5D0 \uBB3B\uC740 \uD759\uBA3C\uC9C0\uB97C \uC870\uC2EC\uC2A4\uB808 \uD138\uC5B4\uB0C8\uB2E4."
    - "[C:\uD2A4\uB9BD] \uC557\u2026\u2026 \uC7A0\uAE50, \uBB50 \uD558\uB294 \uAC70\uC57C?"
    - "[C:\uD2A4\uB9BD] \uB9CC\uC9C0\uC9C0 \uB9C8\u2026\u2026 \uAC04\uC9C0\uB7FD\uB2E8 \uB9D0\uC774\uC57C!"
    - '[CG:tulip_01_closed_bud]'
    - "[N] \uC785\uC73C\uB85C\uB294 \uD241\uBA85\uC2A4\uB7FD\uAC8C \uC3D8\uC544\uBD99\uC774\uBA74\uC11C\uB3C4, \uC18C\uB140\uB294 \uC637\uAE43\uC744 \uAF2D \uC5EC\uC954 \uCC44 \uB3C4\uB9DD\uAC00\uC9C0 \uC54A\uC558\uB2E4."
    - "[N] \uD558\uC580 \uBEA8\uC774 \uC0C8\uBE68\uAC1B\uAC8C \uBB3C\uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    - '[CG_OFF]'
    - "[C:\uD2A4\uB9BD] \uCE6B\u2026\u2026 \uACE0\uC791 \uD759\uBA3C\uC9C0 \uC880 \uD138\uC5B4\uC92C\uB2E4\uACE0 \uB0B4\uAC00 \uAC10\uB3D9\uD560 \uC904 \uC54C\uC544?"
    - "[C:\uD2A4\uB9BD] \u2026\u2026\uADF8\uB798\uB3C4, \uC190\uAE38\uC774 \uC81C\uBC95 \uB2E4\uC815\uD558\uAE34 \uD558\uB124."
    - "[C:\uD2A4\uB9BD] \uB450\uACE0 \uBCFC \uAC70\uC57C. \uB124\uAC00 \uC9C4\uC9DC \uB0A0 \uD53C\uC6CC\uB0BC \uC790\uACA9\uC774 \uC788\uB294\uC9C0."
    - '[EXIT_C]'
    - "[N] \uC0C8\uCE68\uD55C \uACBD\uACE0\uC640 \uD568\uAED8, \uC18C\uB140\uB294 \uB2E4\uC2DC \uB2E8\uB2E8\uD55C \uAF43\uBD09\uC624\uB9AC \uC18D\uC73C\uB85C \uC228\uC5B4\uBC84\uB838\uB2E4."
    - "[N] \uD558\uC9C0\uB9CC \uADF8 \uD2C8\uC0C8\uB85C \uC740\uC740\uD558\uACE0 \uB2EC\uCF64\uD55C \uD5A5\uAE30\uAC00 \uC0C8\uC5B4 \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
  - unlockBondLevel: 2
    title: "\uB098\uB9CC \uBD10\uC8FC\uC9C0 \uC54A\uC73C\uBA74"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uB2E4\uC74C \uB0A0 \uC544\uCE68, \uC815\uC6D0\uC5D0 \uB4E4\uC5B4\uC11C\uC790\uB9C8\uC790 \uC2F8\uB298\uD55C \uAE30\uC6B4\uC774 \uB9F4\uB3CC\uC558\uB2E4."
    - "[N] \uD2A4\uB9BD\uC758 \uC78E\uB05D\uC774 \uD798\uC5C6\uC774 \uC544\uB798\uB85C \uCD95 \uCC98\uC838 \uC788\uC5C8\uB2E4."
    - "[ENTER_C:\uD2A4\uB9BD]"
    - "[N] \uB2E4\uAE09\uD788 \uB2E4\uAC00\uAC00\uC790, \uADF8 \uC560\uB294 \uACE0\uAC1C\uC870\uCC28 \uB4E4\uC9C0 \uC54A\uC558\uB2E4."
    - "[C:\uD2A4\uB9BD] \u2026\u2026\uC624\uC9C0 \uB9C8."
    - "[N] \uBAA9\uC18C\uB9AC\uAC00 \uAC00\uB298\uAC8C \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uD2A4\uB9BD] \uC65C \uC774\uC81C \uC640?"
    - "[C:\uD2A4\uB9BD] \uC544\uAE4C \uBCF4\uB2C8\uAE4C\u2026\u2026 \uC800\uCABD \uD654\uB2E8\uC5D0\uC11C \uB2E4\uB978 \uC2F9\uB9CC \uD55C\uCC38 \uB4E4\uC5EC\uB2E4\uBCF4\uACE0 \uC788\uB354\uB77C?"
    - "[N] \uC624\uD574\uB77C\uACE0, \uC815\uC6D0\uC744 \uC804\uCCB4\uC801\uC73C\uB85C \uB3CC\uBCF4\uACE0 \uC788\uC5C8\uC744 \uBFD0\uC774\uB77C\uACE0 \uB2EC\uB7AC\uB2E4."
    - "[C:\uD2A4\uB9BD] \uADF8\uAC8C \uADF8\uAC70\uC796\uC544!"
    - '[CG:tulip_02_pout_jealousy]'
    - "[N] \uD671 \uB3CC\uC544\uC120 \uADF8 \uC560\uC758 \uB208\uAC00\uC5D0\uB294 \uB208\uBB3C\uC774 \uADF8\uB801\uADF8\uB801 \uB9FA\uD600 \uC788\uC5C8\uB2E4."
    - "[N] \uD30C\uB974\uB974 \uB5A8\uB9AC\uB294 \uC870\uADF8\uB9CC \uB450 \uC190\uC73C\uB85C \uB0B4 \uC637\uC18C\uB9E4\uB97C \uAF49 \uC950\uC5B4\uB72F\uB4EF \uBD99\uC7A1\uC558\uB2E4."
    - "[C:\uD2A4\uB9BD] \uD2A4\uB9BD\uC740\u2026\u2026 \uB098\uB9CC \uBD10\uC8FC\uC9C0 \uC54A\uC73C\uBA74 \uAE08\uBC29 \uC2DC\uB4E4\uC5B4\uBC84\uB9B0\uB2E8 \uB9D0\uC774\uC57C!"
    - "[C:\uD2A4\uB9BD] \uC0AC\uB791\uBC1B\uC9C0 \uBABB\uD558\uB294 \uD2A4\uB9BD\uC774 \uC5BC\uB9C8\uB098 \uBE44\uCC38\uD55C\uC9C0 \uC54C\uC544?"
    - "[C:\uD2A4\uB9BD] \uB0A8\uB4E4 \uB2E4 \uC608\uC058\uAC8C \uD53C\uC5B4\uB0A0 \uB54C, \uB098 \uD63C\uC790 \uC369\uC5B4\uC11C \uBC84\uB824\uC9C8\uAE4C \uBD10\u2026\u2026 \uC5BC\uB9C8\uB098 \uBB34\uC11C\uC6B4\uB370!"
    - '[CG_OFF]'
    - "[N] \uD22C\uC815\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uC0AC\uB791\uBC1B\uC9C0 \uBABB\uD560\uAE4C \uBD10 \uAC81\uC5D0 \uC9C8\uB9B0 \uAC04\uC808\uD55C \uC678\uCE68\uC774\uC5C8\uB2E4."
    - "[N] \uB098\uB294 \uC18C\uB9E4\uB97C \uBD99\uC7A1\uC740 \uADF8 \uC560\uC758 \uB5A8\uB9AC\uB294 \uC190\uC744 \uB450 \uC190\uC73C\uB85C \uB530\uB73B\uD558\uAC8C \uAC10\uC2F8 \uC950\uC5C8\uB2E4."
    - "[N] \uADF8\uB9AC\uACE0 \uAC00\uC7A5 \uB9D1\uC740 \uBB3C\uACFC \uD568\uAED8, \uC9C4\uC2EC\uC744 \uB2F4\uC544 \uC57D\uC18D\uD588\uB2E4."
    - "[N] \uB0B4\uAC8C \uAC00\uC7A5 \uB208\uBD80\uC2E0 \uAF43\uC740 \uC5B8\uC81C\uB098 \uB108\uBFD0\uC774\uB77C\uACE0."
    - "[C:\uD2A4\uB9BD] \u2026\u2026\uC9C4\uC9DC\uC9C0?"
    - "[C:\uD2A4\uB9BD] \uAC70\uC9D3\uB9D0\uC774\uBA74\u2026\u2026 \uB098 \uD3C9\uC0DD \uC548 \uD53C\uC5B4\uB098\uACE0 \uB110 \uC800\uC8FC\uD560 \uAC70\uC57C."
    - "[N] \uD6CC\uCA4D\uAC70\uB9AC\uBA70 \uB208\uBB3C\uC744 \uD6D4\uCE58\uBA74\uC11C\uB3C4, \uC7A1\uC740 \uC190\uC744 \uACB0\uCF54 \uB193\uC9C0 \uC54A\uC558\uB2E4."
    - "[C:\uD2A4\uB9BD] \uC57D\uC18D\uD588\uC73C\uB2C8\uAE4C\u2026\u2026 \uC808\uB300\uB85C \uB534 \uB208 \uD314\uBA74 \uC548 \uB3FC."
    - '[EXIT_C]'
    - "[N] \uADF8\uB0A0 \uC774\uD6C4, \uB2EB\uD600 \uC788\uB358 \uAF43\uBD09\uC624\uB9AC \uB05D\uC774 \uC544\uC8FC \uC870\uAE08, \uBD89\uC740 \uC18D\uC0B4\uC744 \uBE44\uCE58\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - unlockBondLevel: 3
    title: "\uB108\uB9CC\uC744 \uC704\uD55C \uB9CC\uAC1C"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uC544\uCE68 \uD587\uC0B4\uC774 \uC815\uC6D0\uC5D0 \uB2FF\uB294 \uC21C\uAC04, \uB208\uC774 \uBD80\uC2E4 \uC815\uB3C4\uC758 \uBD89\uC740 \uAD11\uCC44\uAC00 \uBC88\uC838\uB098\uAC14\uB2E4."
    - "[N] \uAD73\uAC8C \uB2EB\uD600 \uC788\uB358 \uD2A4\uB9BD\uC758 \uAF43\uBD09\uC624\uB9AC\uAC00, \uAC70\uC9D3\uB9D0\uCC98\uB7FC \uD65C\uC9DD \uD53C\uC5B4\uB098 \uC788\uC5C8\uB2E4."
    - "[ENTER_C:\uD2A4\uB9BD]"
    - "[C:\uD2A4\uB9BD] \uBC14\uBCF4\uC57C! \uC5B8\uC81C\uAE4C\uC9C0 \uBA4D\uD558\uB2C8 \uC11C \uC788\uC744 \uAC70\uC57C!"
    - "[N] \uBD80\uB4DC\uB7FD\uAC8C \uD769\uB0A0\uB9AC\uB294 \uBD89\uC740 \uB4DC\uB808\uC2A4\uB97C \uC785\uACE0, \uB208\uBD80\uC2DC\uAC8C \uD53C\uC5B4\uB09C \uD2A4\uB9BD\uC774 \uB098\uB97C \uD5A5\uD574 \uB2EC\uB824\uC654\uB2E4."
    - '[CG:tulip_03_blooming_love]'
    - "[N] \uC640\uB77D \uC548\uACA8\uC624\uB294 \uC791\uC740 \uBAB8\uC5D0\uC11C \uC228\uC774 \uBA4E\uC744 \uB4EF \uB2EC\uCF64\uD558\uACE0 \uB9E4\uD639\uC801\uC778 \uD5A5\uAE30\uAC00 \uC3DF\uC544\uC84C\uB2E4."
    - "[C:\uD2A4\uB9BD] \uBD24\uC9C0? \uB0B4 \uBAA8\uB4E0 \uAF43\uC78E\uC774\u2026\u2026 \uC804\uBD80 \uD65C\uC9DD \uC5F4\uB838\uC5B4!"
    - "[C:\uD2A4\uB9BD] \uC624\uC9C1 \uB108 \uD558\uB098\uB9CC\uC744 \uC704\uD574, \uBA38\uB9AC\uBD80\uD130 \uBC1C\uB05D\uAE4C\uC9C0 \uC804\uBD80 \uB2E4!"
    - "[N] \uADF8 \uC560\uC758 \uB450 \uD314\uC774 \uB0B4 \uBAA9\uC744 \uB2E8\uB2E8\uD788 \uB04C\uC5B4\uC548\uC558\uB2E4."
    - "[N] \uADD3\uAC00\uC5D0 \uB2FF\uB294 \uC228\uACB0\uC774 \uB728\uAC70\uC6B8 \uC815\uB3C4\uB85C \uB2EC\uCF64\uD588\uB2E4."
    - "[C:\uD2A4\uB9BD] \uB124\uAC00 \uB9E4\uC77C \uB0A0 \uBC14\uB77C\uBD10\uC8FC\uACE0, \uB2E4\uC815\uD558\uAC8C \uB9CC\uC838\uC8FC\uACE0, \uC0AC\uB791\uD574\uC918\uC11C \uD53C\uC5B4\uB09C \uAC70\uC57C."
    - "[C:\uD2A4\uB9BD] \uC774\uC81C \uB09C \uB108 \uC5C6\uC73C\uBA74 \uC808\uB300\uB85C \uBABB \uC0B4\uC544."
    - "[C:\uD2A4\uB9BD] \uADF8\uB7EC\uB2C8\uAE4C\u2026\u2026 \uD3C9\uC0DD \uB0A0 \uCC45\uC784\uC838\uC57C \uD574."
    - '[CG_OFF]'
    - "[N] \uC0B4\uC9DD \uACE0\uAC1C\uB97C \uB4E0 \uADF8 \uC560\uC758 \uC5BC\uAD74\uC740, \uD53C\uC5B4\uB09C \uAF43\uC78E\uBCF4\uB2E4 \uB354 \uBD89\uACE0 \uCC2C\uB780\uD558\uAC8C \uBE5B\uB098\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uD2A4\uB9BD] \uB2E4\uB978 \uAF43\uC740 \uCCD0\uB2E4\uBCF4\uC9C0\uB3C4 \uBABB\uD558\uAC8C, \uB9E4\uC77C\uB9E4\uC77C \uB0B4 \uC0AC\uB791\uC73C\uB85C \uAC00\uB4DD \uC228 \uB9C9\uD788\uAC8C \uD574\uC904 \uD14C\uB2C8\uAE4C."
    - "[C:\uD2A4\uB9BD] \uAC01\uC624\uD574? \uC0AC\uB791\uD574\u2026\u2026 \uB098\uC758 \uC815\uC6D0\uC0AC\uB2D8!"
    - "[N] \uBD04\uBC14\uB78C\uBCF4\uB2E4 \uB354 \uB728\uAC70\uC6B4 \uACE0\uBC31\uACFC \uD568\uAED8, \uC815\uC6D0\uC740 \uB458\uB9CC\uC758 \uC628\uAE30\uB85C \uAC00\uB4DD \uCC44\uC6CC\uC84C\uB2E4."
    - '[EXIT_C]'
