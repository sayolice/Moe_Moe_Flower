  memorialEntries:
  - unlockBondLevel: 1
    title: "\uBE44 \uB0B4\uB9AC\uB294 \uD654\uB2E8\uC758 \uC6C5\uD06C\uB9BC"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uC815\uC6D0\uC5D0 \uBD80\uC2AC\uBD80\uC2AC \uC548\uAC1C\uBE44\uAC00 \uB0B4\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    - "[N] \uBE57\uBC29\uC6B8\uC774 \uCC28\uBD84\uD558\uAC8C \uD759\uC744 \uC801\uC2DC\uB294 \uD654\uB2E8 \uAD6C\uC11D, \uC720\uB3C5 \uB208\uC5D0 \uB744\uB294 \uBCF4\uB78F\uBE5B \uBABD\uC6B0\uB9AC\uAC00 \uC788\uC5C8\uB2E4."
    - "[ENTER_C:\uC218\uAD6D]"
    - "[N] \uC5F0\uBCF4\uB78F\uBE5B \uAE34 \uBA38\uB9AC\uB97C \uB298\uC5B4\uB728\uB9B0 \uC18C\uB140\uAC00, \uBB34\uB98E\uC744 \uC591\uD314\uB85C \uAF2D \uB04C\uC5B4\uC548\uC740 \uCC44 \uC6C5\uD06C\uB824 \uC549\uC544 \uC788\uC5C8\uB2E4."
    - "[C:\uC218\uAD6D] \u2026\u2026\uB611, \uB611."
    - "[N] \uADF8\uB140\uB294 \uBB34\uB98E\uC5D0 \uD131\uC744 \uAD38 \uCC44, \uC78E\uC0AC\uADC0 \uB05D\uC5D0\uC11C \uB5A8\uC5B4\uC9C0\uB294 \uBE57\uBC29\uC6B8 \uC18C\uB9AC\uB97C \uC138\uACE0 \uC788\uC5C8\uB2E4."
    - "[N] \uAC10\uAE30\uC5D0 \uAC78\uB9B4\uAE4C \uAC71\uC815\uB418\uC5B4 \uC6B0\uC0B0\uC744 \uADF8\uB140\uC758 \uBA38\uB9AC \uC704\uB85C \uAC00\uB9CC\uD788 \uAE30\uC6B8\uC5EC\uC8FC\uC5C8\uB2E4."
    - "[C:\uC218\uAD6D] \u2026\u2026\uC544."
    - "[N] \uC18C\uB140\uAC00 \uCC9C\uCC9C\uD788 \uACE0\uAC1C\uB97C \uB4E4\uC5C8\uB2E4."
    - "[N] \uBCF4\uC11D\uCC98\uB7FC \uD22C\uBA85\uD55C \uBCF4\uB78F\uBE5B \uB208\uB3D9\uC790\uC5D0, \uC816\uC740 \uC548\uAC2F\uBE5B\uC774 \uC5B4\uB824 \uC788\uC5C8\uB2E4."
    - "[C:\uC218\uAD6D] \uC6B0\uC0B0\uC740\u2026\u2026 \uAD1C\uCC2E\uC544\uC694, \uC815\uC6D0\uC0AC\uB2D8."
    - "[N] \uC870\uC6A9\uD558\uACE0 \uB098\uC9C0\uB9C9\uD55C \uBAA9\uC18C\uB9AC. \uBE57\uC18C\uB9AC \uC18D\uC5D0 \uC2A4\uBA70\uB4E4 \uB4EF \uBD80\uB4DC\uB7EC\uC6E0\uB2E4."
    - "[C:\uC218\uAD6D] \uC804 \uBE44\uB97C \uB9DE\uB294 \uAC8C \uC88B\uC544\uC694. \uCC28\uAC00\uC6B4 \uBE57\uBB3C\uC774\u2026\u2026 \uC81C \uAF43\uC78E\uC758 \uC0C9\uC744 \uAC00\uB9CC\uD788 \uC53B\uC5B4\uB0B4 \uC8FC\uB2C8\uAE4C\uC694."
    - '[CG:hydrangea_01_rain_curl]'
    - "[N] \uC816\uC740 \uCE58\uB9DB\uC790\uB77D \uB05D\uC774, \uBE57\uBB3C\uACFC \uD759\uC758 \uC228\uACB0\uC5D0 \uB2FF\uC544 \uC11C\uC11C\uD788 \uD478\uB978\uBE5B\uC5D0\uC11C \uC605\uC740 \uBCF4\uB78F\uBE5B\uC73C\uB85C \uBB3C\uB4E4\uC5B4 \uAC00\uACE0 \uC788\uC5C8\uB2E4."
    - "[N] \uBE44\uC5D0 \uC816\uB294 \uAC83\uC744 \uB450\uB824\uC6CC\uD558\uC9C0 \uC54A\uC73C\uBA74\uC11C\uB3C4, \uADF8\uB140\uC758 \uC5B4\uAE68\uB294 \uC5B4\uB518\uAC00 \uBAA8\uB974\uAC8C \uC794\uB729 \uC6C0\uCE20\uB7EC\uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    - '[CG_OFF]'
    - "[C:\uC218\uAD6D] \uC218\uAD6D\uC740\u2026\u2026 \uCC38 \uC774\uC0C1\uD55C \uAF43\uC774\uC8E0?"
    - "[C:\uC218\uAD6D] \uAC00\uB9CC\uD788 \uBA38\uBB3C\uB7EC\uC788\uC9C0 \uBABB\uD558\uACE0, \uC790\uAFB8\uB9CC \uB2E4\uB978 \uC0C9\uC73C\uB85C \uBCC0\uD574\uBC84\uB9AC\uB2C8\uAE4C\uC694."
    - "[C:\uC218\uAD6D] \uB0B4\uC77C\uC740\u2026\u2026 \uB610 \uC5B4\uB5A4 \uC0C9\uC774 \uB418\uC5B4 \uC788\uC744\uAE4C\uC694."
    - "[N] \uC2A4\uC2A4\uB85C\uB97C \uC6D0\uB9DD\uD558\uB294 \uB4EF\uD55C \uC791\uC740 \uC18D\uC0AD\uC784."
    - '[EXIT_C]'
    - "[N] \uADF8\uB140\uB294 \uB2E4\uC2DC \uBB34\uB98E\uC5D0 \uC5BC\uAD74\uC744 \uBB3B\uC5C8\uB2E4."
    - "[N] \uBE44\uB294 \uADF8\uCE58\uC9C0 \uC54A\uACE0, \uC218\uAD6D\uC758 \uBA38\uB9AC\uCE7C \uC704\uB85C \uC870\uC6A9\uD788 \uD758\uB7EC\uB0B4\uB838\uB2E4."
  - unlockBondLevel: 2
    title: "\uBCC0\uB355\uC2A4\uB7EC\uC6B4 \uC0C9\uC758 \uB450\uB824\uC6C0"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uBA70\uCE60 \uB4A4 \uC815\uC6D0\uC744 \uCC3E\uC558\uC744 \uB54C, \uD654\uB2E8 \uBD84\uC704\uAE30\uAC00 \uC0AC\uBB47 \uB2EC\uB77C\uC838 \uC788\uC5C8\uB2E4."
    - "[N] \uC9C0\uB09C\uBC88\uC5D4 \uB9D1\uC740 \uD478\uB978\uBE5B\uC774\uB358 \uC218\uAD6D\uC758 \uAF43\uC78E\uC774, \uBD89\uC740\uBE5B\uC774 \uB9F4\uB3C4\uB294 \uC9D9\uC740 \uC790\uC8FC\uC0C9\uC73C\uB85C \uBCC0\uD574 \uC788\uC5C8\uB2E4."
    - "[ENTER_C:\uC218\uAD6D]"
    - "[N] \uBC18\uAC00\uC6B4 \uB9C8\uC74C\uC5D0 \uB2E4\uAC00\uAC00\uC790, \uADF8\uB140\uB294 \uD654\uB4E4\uC9DD \uB180\uB77C\uBA70 \uC78E\uC0AC\uADC0 \uB4A4\uB85C \uC228\uC5B4\uBC84\uB838\uB2E4."
    - "[C:\uC218\uAD6D] \uC624, \uC624\uC9C0 \uB9C8\uC138\uC694\u2026\u2026!"
    - "[N] \uB2F9\uD669\uD55C \uBAA9\uC18C\uB9AC\uC5D0\uB294 \uAE4A\uC740 \uC218\uCE58\uC2EC\uACFC \uACF5\uD3EC\uAC00 \uBB3B\uC5B4\uB098 \uC788\uC5C8\uB2E4."
    - "[C:\uC218\uAD6D] \uBCF4\uC9C0 \uB9C8\uC138\uC694\u2026\u2026 \uB610 \uC0C9\uC774 \uBCC0\uD574\uBC84\uB838\uB2E8 \uB9D0\uC774\uC5D0\uC694\u2026\u2026!"
    - "[C:\uC218\uAD6D] \uC5B4\uC81C\uB294 \uB9D1\uC740 \uD558\uB298\uC0C9\uC774\uC5C8\uB294\uB370\u2026\u2026 \uC624\uB298\uC740 \uC774\uB7F0 \uBD89\uACE0 \uD0C1\uD55C \uC0C9\uC774 \uB418\uC5B4\uBC84\uB838\uC5B4\uC694\u2026\u2026!"
    - "[N] \uADF8\uAC8C \uBB34\uC2A8 \uC0C1\uAD00\uC774\uB0D0\uBA70 \uB2E4\uAC00\uAC00\uC790, \uADF8\uB140\uB294 \uD544\uC0AC\uC801\uC73C\uB85C \uCE58\uB9DB\uC790\uB77D\uC744 \uAC10\uCD94\uBA70 \uBB3C\uB7EC\uC130\uB2E4."
    - '[CG:hydrangea_02_color_fear]'
    - "[N] \uADF8\uB140\uC758 \uCEE4\uB2E4\uB780 \uBCF4\uB78F\uBE5B \uB208\uB3D9\uC790\uC5D0 \uB208\uBB3C\uC774 \uADF8\uB801\uADF8\uB801 \uCC28\uC62C\uB77C \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uC218\uAD6D] \uB2E4\uB4E4 \uADF8\uB7AC\uC5B4\uC694\u2026\u2026 \uC0C9\uC774 \uBC14\uB014 \uB54C\uB9C8\uB2E4 \uBCC0\uB355\uC2A4\uB7FD\uB2E4\uBA70, \uC608\uC804 \uC0C9\uC774 \uB354 \uC608\uBEE4\uB2E4\uBA70 \uC2E4\uB9DD\uD558\uACE0 \uB5A0\uB098\uAC14\uC5B4\uC694!"
    - "[C:\uC218\uAD6D] \uC218\uAD6D\uC740 \uB9C8\uC74C\uC774 \uC27D\uAC8C \uBCC0\uD558\uB294 \uB0C9\uC815\uD55C \uAF43\uC774\uB77C\uACE0\u2026\u2026!"
    - "[C:\uC218\uAD6D] \uB2F9\uC2E0\uB3C4\u2026\u2026 \uB2F9\uC2E0\uB3C4 \uBCC0\uD574\uBC84\uB9B0 \uC808 \uBCF4\uACE0 \uC2E4\uB9DD\uD574\uC11C \uB4F1\uC744 \uB3CC\uB9B4 \uAC70\uC796\uC544\uC694\u2026\u2026!"
    - '[CG_OFF]'
    - "[N] \uC11C\uB7EC\uC6B4 \uB208\uBB3C\uC774 \uBE57\uBC29\uC6B8\uCC98\uB7FC \uBEA8\uC744 \uD0C0\uACE0 \uD758\uB7EC\uB0B4\uB838\uB2E4."
    - "[N] \uC0C9\uC774 \uBCC0\uD558\uB294 \uAC83\uC740 \uBCC0\uB355\uC774 \uC544\uB2C8\uB77C, \uD658\uACBD\uC744 \uC628\uBAB8\uC73C\uB85C \uBC1B\uC544\uB4E4\uC774\uB294 \uC5EC\uB9B0 \uC21C\uC218\uD568\uC774\uC5C8\uC744 \uBFD0\uC778\uB370."
    - "[N] \uB098\uB294 \uB3C4\uB9DD\uCE58\uB824\uB294 \uADF8\uB140\uC758 \uC816\uC740 \uC190\uC744 \uB450 \uC190\uC73C\uB85C \uC870\uC2EC\uC2A4\uB7FD\uAC8C, \uD558\uC9C0\uB9CC \uB2E8\uB2E8\uD788 \uBD99\uC7A1\uC558\uB2E4."
    - "[N] \uD478\uB978\uC0C9\uC774\uC5B4\uB3C4, \uBD89\uC740\uC0C9\uC774\uC5B4\uB3C4, \uBCF4\uB77C\uC0C9\uC774\uC5B4\uB3C4 \uC0C1\uAD00\uC5C6\uB2E4\uACE0."
    - "[N] \uB124\uAC00 \uC5B4\uB5A4 \uC0C9\uC744 \uD488\uB4E0, \uADF8 \uBAA8\uB4E0 \uC0C9\uC774 \uC804\uBD80 \uB108\uC774\uAE30\uC5D0 \uB098\uB294 \uB2E8 \uD55C \uC21C\uAC04\uB3C4 \uC2E4\uB9DD\uD558\uC9C0 \uC54A\uB294\uB2E4\uACE0."
    - "[C:\uC218\uAD6D] \u2026\u2026\uC544."
    - "[N] \uB5A8\uB9AC\uB294 \uADF8\uB140\uC758 \uC190\uB05D\uC73C\uB85C \uB0B4 \uC628\uAE30\uAC00 \uC804\uD574\uC9C0\uC790, \uB69D\uB69D \uB5A8\uC5B4\uC9C0\uB358 \uB208\uBB3C\uC774 \uBA4E\uC5C8\uB2E4."
    - "[C:\uC218\uAD6D] \uC815\uB9D0\u2026\u2026 \uC815\uB9D0\uB85C \uC808 \uC2EB\uC5B4\uD558\uC9C0 \uC54A\uC73C\uC2DC\uB294 \uAC74\uAC00\uC694\u2026\u2026?"
    - "[N] \uACE0\uAC1C\uB97C \uB044\uB355\uC774\uBA70 \uC816\uC740 \uB208\uAC00\uB97C \uC870\uC2EC\uC2A4\uB808 \uB2E6\uC544\uC8FC\uC790, \uADF8\uB140\uC758 \uBCFC\uC774 \uBD89\uC740 \uAF43\uC78E\uCC98\uB7FC \uBC1C\uAC1B\uAC8C \uB2EC\uC544\uC62C\uB790\uB2E4."
    - '[EXIT_C]'
    - "[N] \uBE57\uC18D\uC5D0\uC11C \uB9C8\uC8FC \uC7A1\uC740 \uC190\uC740, \uC5B4\uB5A4 \uB0A0\uC528\uBCF4\uB2E4\uB3C4 \uB530\uB73B\uD588\uB2E4."
  - unlockBondLevel: 3
    title: "\uBE44 \uAC20 \uB4A4\uC758 \uBB34\uC9C0\uAC1C\uCC98\uB7FC"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uAE38\uACE0 \uAE38\uC5C8\uB358 \uC7A5\uB9C8\uAC00 \uB9C8\uCE68\uB0B4 \uB05D\uB0AC\uB2E4."
    - "[N] \uBA39\uAD6C\uB984\uC774 \uAC77\uD78C \uD478\uB978 \uD558\uB298 \uC704\uB85C, \uB208\uBD80\uC2E0 \uBB34\uC9C0\uAC1C\uAC00 \uB2E4\uB9AC\uB97C \uB193\uC558\uB2E4."
    - "[N] \uBE57\uBC29\uC6B8\uC744 \uBA38\uAE08\uC740 \uC815\uC6D0\uC758 \uB098\uBB47\uC78E\uB4E4\uC774 \uBCF4\uC11D\uCC98\uB7FC \uBC18\uC9DD\uC600\uB2E4."
    - "[ENTER_C:\uC218\uAD6D]"
    - "[N] \uADF8\uB9AC\uACE0 \uD654\uB2E8 \uD55C\uAC00\uC6B4\uB370, \uC5B8\uC81C\uB098 \uBB34\uB98E\uC744 \uB04C\uC5B4\uC548\uACE0 \uC6C5\uD06C\uB824 \uC788\uB358 \uADF8\uB140\uAC00 \uC11C \uC788\uC5C8\uB2E4."
    - "[C:\uC218\uAD6D] \uC815\uC6D0\uC0AC\uB2D8\u2026\u2026"
    - "[N] \uADF8\uB140\uAC00 \uC0DD\uC560 \uCC98\uC74C\uC73C\uB85C, \uC6C5\uD06C\uB838\uB358 \uB2E4\uB9AC\uB97C \uD3B4\uACE0 \uB0B4\uAC8C \uD55C \uAC78\uC74C\uC529 \uAC78\uC5B4\uC654\uB2E4."
    - "[N] \uD587\uC0B4\uC744 \uBC1B\uC740 \uADF8\uB140\uC758 \uB4DC\uB808\uC2A4\uB294 \uAE30\uC801\uCC98\uB7FC \uD478\uB978\uBE5B, \uBD84\uD64D\uBE5B, \uBCF4\uB78F\uBE5B\uC774 \uCE35\uCE35\uC774 \uC5B4\uC6B0\uB7EC\uC838 \uBB34\uC9C0\uAC1C\uCC98\uB7FC \uBE5B\uB098\uACE0 \uC788\uC5C8\uB2E4."
    - '[CG:hydrangea_03_rainbow_smile]'
    - "[N] \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB2E4\uAC00\uC628 \uADF8\uB140\uAC00, \uB5A8\uB9AC\uB294 \uB450 \uC190\uC73C\uB85C \uB0B4 \uC637\uAE43\uC744 \uAF2D \uC950\uC5C8\uB2E4."
    - "[N] \uADF8\uB9AC\uACE0 \uC62C\uB824\uB2E4\uBCF4\uB294 \uC5BC\uAD74\uC5D0, \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uB9D1\uACE0 \uB208\uBD80\uC2E0 \uBBF8\uC18C\uAC00 \uD53C\uC5B4\uB0AC\uB2E4."
    - "[C:\uC218\uAD6D] \uC774\uC81C \uC54C\uC558\uC5B4\uC694\u2026\u2026 \uC0C9\uC774 \uBCC0\uD55C\uB2E4\uB294 \uAC74, \uBCC0\uB355\uC774 \uC544\uB2C8\uB77C\uB294 \uAC83\uC744."
    - "[C:\uC218\uAD6D] \uD759\uC758 \uC0AC\uB791\uB3C4, \uB0B4\uB9AC\uB294 \uBE44\uB3C4, \uC815\uC6D0\uC0AC\uB2D8\uC758 \uC628\uAE30\uB3C4\u2026\u2026 \uC804\uBD80 \uB0B4 \uC548\uC5D0 \uD488\uC5B4\uB0B4\uACE0 \uC788\uC5C8\uB2E4\uB294 \uAC83\uC744\uC694."
    - "[N] \uADF8\uB140\uC758 \uACE0\uC6B4 \uC5F0\uBCF4\uB78F\uBE5B \uBA38\uB9BF\uACB0\uC774 \uBC14\uB78C\uC5D0 \uAE30\uBD84 \uC88B\uAC8C \uD769\uB0A0\uB838\uB2E4."
    - "[C:\uC218\uAD6D] \uB2F9\uC2E0\uACFC \uD568\uAED8\uB77C\uBA74\u2026\u2026 \uC81C \uC0C9\uC774 \uCC9C \uBC88, \uB9CC \uBC88\uC744 \uBC14\uB00C\uC5B4\uB3C4 \uB450\uB835\uC9C0 \uC54A\uC544\uC694."
