  memorialEntries:
  - unlockBondLevel: 1
    title: "\uC774\uB984\uC5C6\uB294 \uAC83"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uCC98\uC74C\uC5D4 \uC7A1\uCD08\uC778 \uC904 \uC54C\uC558\uB2E4."
    - "[N] \uD654\uB2E8 \uAC00\uC7A5\uC790\uB9AC, \uBCBD\uB3CC \uD2C8\uC73C\uB85C
      \uC090\uC838\uB098\uC628 \uC790\uB9AC."
    - "[N] \uBA87 \uBC88\uC774\uB098 \uADF8 \uC704\uB97C \uBC1F\uACE0 \uC9C0\uB098\uB2E4\uB154\uB2E4."
    - "[N] \uADF8\uB0A0\uB3C4 \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB824\uB358 \uCC38\uC774\uC5C8\uB2E4."
    - "[N] \uB178\uB780 \uAC83\uC774 \uD558\uB098 \uC788\uC5C8\uB2E4."
    - "[ENTER_C:\uBBFC\uB4E4\uB808]"
    - "[C:\uBBFC\uB4E4\uB808] \u2026\u2026\uBD24\uC5B4?"
    - "[N] \uB180\uB77C\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uAC70\uC9D3\uB9D0\uC774\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uC544\uB2C8, \uBBF8\uC548. \uB180\uB784 \uC904 \uBAB0\uB790\uC5B4."
    - "[C:\uBBFC\uB4E4\uB808] \uC5EC\uAE30 \uC624\uB798 \uC788\uC5C8\uAC70\uB4E0.
      \uC544\uBB34\uB3C4 \uC548 \uBD10\uC11C."
    - "[N] \uC624\uB798, \uB77C\uACE0 \uD588\uB2E4."
    - "[N] \uC5BC\uB9C8\uB098 \uC624\uB798\uC778\uC9C0\uB294 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uC774\uB984 \uAC19\uC740 \uAC74 \uC5C6\uC5B4."
    - "[C:\uBBFC\uB4E4\uB808] \uB2E4\uB4E4 \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB2C8\uAE4C,
      \uD544\uC694\uAC00 \uC5C6\uC5C8\uC5B4."
    - "[C:\uBBFC\uB4E4\uB808] \uADFC\uB370 \uC9C0\uAE08\uC740 \uC880 \uC774\uC0C1\uD558\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uADFC\uB370 \uC9C0\uAE08\uC740 \uC880 \uC774\uC0C1\uD558\uB2E4."
    - "[N] \uBB34\uC5C7\uC774 \uC774\uC0C1\uD558\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uB124\uAC00 \uBA48\uCDB0 \uC130\uC796\uC544."
    - '[CG:dandelion_01_first_look]'
    - "[N] \uADF8 \uC560\uB294 \uB098\uB97C \uC62C\uB824\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    - "[N] \uC6C3\uC9C0\uB3C4 \uC54A\uACE0, \uBC18\uAE30\uC9C0\uB3C4 \uC54A\uACE0,"
    - "[N] \uADF8\uB0E5 \uB0B4\uAC00 \uC544\uC9C1 \uAC70\uAE30 \uC788\uB294\uC9C0
      \uD655\uC778\uD558\uB294 \uAC83\uCC98\uB7FC."
    - '[CG_OFF]'
    - "[C:\uBBFC\uB4E4\uB808] \uACE7 \uAC08 \uAC70\uC9C0?"
    - "[N] \uC544\uB2C8\uB77C\uACE0 \uB300\uB2F5\uD588\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \u2026\u2026\uADF8\uB798."
    - "[C:\uBBFC\uB4E4\uB808] \uADF8\uB7FC \uC870\uAE08\uB9CC \uB354 \uC788\uC5B4
      \uC918."
    - '[EXIT_C]'
    - "[N] \uADF8\uB0A0 \uB098\uB294 \uD654\uB2E8 \uAC00\uC7A5\uC790\uB9AC\uB97C
      \uBC1F\uC9C0 \uC54A\uACE0 \uB3CC\uC544\uAC14\uB2E4."
    - "[N] \uCC98\uC74C \uC788\uB294 \uC77C\uC774\uC5C8\uB2E4."
  - unlockBondLevel: 2
    title: "\uBC14\uB78C\uC774 \uBD80\uB294 \uB0A0"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uBC14\uB78C\uC774 \uBD80\uB294 \uB0A0\uC774\uC5C8\uB2E4."
    - "[ENTER_C:\uBBFC\uB4E4\uB808]"
    - "[C:\uBBFC\uB4E4\uB808] \uC654\uB124."
    - "[N] \uADF8 \uC560\uB294 \uC774\uC81C \uB180\uB77C\uC9C0 \uC54A\uC558\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uC624\uB298\uC740 \uC880 \uC2DC\uB044\uB7EC\uC6CC."
    - "[N] \uBB34\uC5C7\uC774 \uC2DC\uB044\uB7FD\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uBC14\uB78C."
    - "[N] \uADF8\uB7EC\uACE0 \uBCF4\uB2C8 \uD770 \uAC83\uB4E4\uC774 \uB5A0\uB2E4\uB2C8\uACE0
      \uC788\uC5C8\uB2E4."
    - "[N] \uADF8 \uC560\uC758 \uBA38\uB9AC\uC5D0\uC11C, \uC5B4\uAE68\uC5D0\uC11C,
      \uC190\uB05D\uC5D0\uC11C."
    - "[N] \uD558\uB098\uC529 \uB5A8\uC5B4\uC838 \uB098\uAC00\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uC544, \uC774\uAC70?"
    - "[C:\uBBFC\uB4E4\uB808] \uAD1C\uCC2E\uC544. \uC6D0\uB798 \uADF8\uB798."
    - "[N] \uC544\uD504\uC9C0 \uC54A\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uC74C\u2026\u2026 \uC544\uD508 \uAC74 \uC544\uB2C8\uC57C."
    - "[C:\uBBFC\uB4E4\uB808] \uADF8\uB0E5, \uAC00\uB294 \uAC70\uC57C."
    - "[N] \uC5B4\uB514\uB85C \uAC00\uB294\uC9C0 \uC544\uB290\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uBAB0\uB77C."
    - "[C:\uBBFC\uB4E4\uB808] \uC54C\uBA74 \uC88B\uC744 \uD150\uB370."
    - "[N] \uADF8 \uC560\uB294 \uC190\uC744 \uBED7\uC5C8\uB2E4."
    - "[N] \uC7A1\uC73C\uB824\uB294 \uAC83 \uAC19\uAE30\uB3C4 \uD588\uACE0,"
    - "[N] \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB294 \uAC78 \uB9CC\uC838\uBCF4\uB294
      \uAC83 \uAC19\uAE30\uB3C4 \uD588\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uC608\uC804\uC5D4 \uC138\uC5B4\uBD24\uC5B4."
    - "[C:\uBBFC\uB4E4\uB808] \uBA87 \uAC1C\uB098 \uAC14\uB294\uC9C0."
    - "[C:\uBBFC\uB4E4\uB808] \uADFC\uB370 \uC138\uB2E4 \uBCF4\uBA74 \uC790\uAFB8
      \uB193\uCCD0\uC11C, \uADF8\uB9CC\uB480\uC5B4."
    - "[N] \uB098\uB294 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    - "[N] \uD770 \uAC83 \uD558\uB098\uAC00 \uB0B4 \uC637\uAE43\uC5D0 \uBD99\uC5C8\uB2E4\uAC00,
      \uB2E4\uC2DC \uB5A0\uC62C\uB790\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \u2026\u2026\uC788\uC796\uC544."
    - "[C:\uBBFC\uB4E4\uB808] \uB108\uB294 \uC548 \uC7A1\uC744 \uAC70\uC57C?"
    - "[N] \uC7A1\uC73C\uBA74 \uC5B4\uB5BB\uAC8C \uB418\uB0D0\uACE0 \uBB3C\uC5C8\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uAE00\uC384. \uC544\uBB34\uB3C4 \uC548 \uC7A1\uC544\uBD24\uC5B4."
    - "[N] \uB098\uB294 \uC190\uC744 \uBED7\uC9C0 \uC54A\uC558\uB2E4."
    - "[N] \uB300\uC2E0 \uADF8 \uC790\uB9AC\uC5D0 \uC870\uAE08 \uB354 \uC11C \uC788\uC5C8\uB2E4."
    - "[C:\uBBFC\uB4E4\uB808] \uADF8\uB798."
    - "[C:\uBBFC\uB4E4\uB808] \uADF8\uAC83\uB3C4 \uAD1C\uCC2E\uB124."
    - '[EXIT_C]'
    - "[N] \uBC14\uB78C\uC774 \uADF8\uCE60 \uB54C\uAE4C\uC9C0, \uC6B0\uB9AC\uB294
      \uC544\uBB34\uAC83\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
