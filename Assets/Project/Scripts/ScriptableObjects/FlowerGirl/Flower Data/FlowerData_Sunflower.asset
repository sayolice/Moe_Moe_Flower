  passives:
  - passiveId: sunflower_gps_bonus
    displayName: "\uD55C\uB0AE\uC758 \uD587\uC0B4"
    description: "\uBAA8\uB4E0 \uAF43\uC758 G/s +2% (\uC628\uB77C\uC778/\uC624\uD504\uB77C\uC778 \uB3D9\uC77C)"
    effectType: 3
