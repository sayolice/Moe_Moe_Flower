  memorialEntries:
  - unlockBondLevel: 1
    title: "\uC5B8\uC81C\uB098 \uB9D1\uC74C \uB4A4, \uC7A0\uAE50\uC758 \uADF8\uB298"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uD654\uB2E8 \uD55C\uAC00\uC6B4\uB370, \uC720\uB3C5 \uC2DC\uC6D0\uC2DC\uC6D0\uD55C \uD0A4\uB85C \uD558\uB298\uC744 \uD5A5\uD574 \uBED7\uC5B4 \uC624\uB978 \uAF43\uC774 \uC788\uC5C8\uB2E4."
    - "[N] \uCC59\uC774 \uB113\uC740 \uBC00\uC9DA\uBAA8\uC790\uC5D0 \uD48D\uC131\uD55C \uAC08\uC0C9 \uD3EC\uB2C8\uD14C\uC77C\uC744 \uCC30\uB791\uC774\uB294 \uC18C\uB140\uC600\uB2E4."
    - "[ENTER_C:\uD574\uBC14\uB77C\uAE30]"
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC5EC\uC5B4! \uC815\uC6D0\uC0AC! \uC624\uB298\uB3C4 \uB0A0\uC528 \uC644\uC804 \uB05D\uB0B4\uC8FC\uC9C0 \uC54A\uC544?"
    - "[N] \uAC00\uC2B4\uC5D0 \uC120\uAE00\uB77C\uC2A4\uB97C \uAC78\uCE5C \uCC44, \uADF8\uB140\uB294 \uC2DC\uC6D0\uD558\uAC8C \uC6C3\uC73C\uBA70 \uB0B4 \uC5B4\uAE68\uB97C \uD22D \uCCE4\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uB09C \uD574\uBC14\uB77C\uAE30\uC57C! \uBCF4\uB2E4\uC2DC\uD53C \uC815\uC6D0\uC758 \uC5D0\uB108\uC9C0\uB294 \uC804\uBD80 \uB0B4\uAC00 \uCC45\uC784\uC9C0\uACE0 \uC788\uC9C0!"
    - "[C:\uD574\uBC14\uB77C\uAE30] \uB354\uC6B0\uBA74 \uC5B8\uC81C\uB4E0 \uB9D0\uD574. \uB0B4 \uD070 \uC78E\uC0AC\uADC0\uB85C \uC5BC\uB9C8\uB4E0\uC9C0 \uADF8\uB298\uC744 \uB9CC\uB4E4\uC5B4\uC904 \uD14C\uB2C8\uAE4C!"
    - "[N] \uD138\uD138\uD558\uACE0 \uC529\uC529\uD55C \uBAA9\uC18C\uB9AC. \uC815\uC6D0\uC758 \uBAA8\uB4E0 \uAF43\uB4E4\uC5D0\uAC8C \uBE44\uD0C0\uBBFC \uAC19\uC740 \uC874\uC7AC\uC600\uB2E4."
    - "[N] \uADF8\uB140\uB294 \uD55C\uCC38 \uB3D9\uC548\uC774\uB098 \uB2E4\uB978 \uAF43\uB4E4\uC758 \uC0C1\uD0DC\uB97C \uC0B4\uD53C\uACE0, \uBB3C\uC744 \uCC59\uACA8\uC8FC\uBA70 \uD65C\uAE30\uCC28\uAC8C \uB6F0\uC5B4\uB2E4\uB154\uB2E4."
    - "[N] \uADF8\uB9AC\uACE0 \uBAA8\uB450\uAC00 \uC790\uB9AC\uB97C \uBE44\uC6B4 \uB2A6\uC740 \uC624\uD6C4."
    - '[CG:sunflower_01_hidden_sigh]'
    - "[N] \uBC00\uC9DA\uBAA8\uC790 \uCC59\uC744 \uC0B4\uC9DD \uB204\uB978 \uCC44, \uADF8\uB140\uB294 \uB178\uC744\uBE5B\uC774 \uC9C0\uB294 \uD5C8\uACF5\uC744 \uBA4D\uD558\uB2C8 \uBC14\uB77C\uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    - "[N] \uB0AE \uB3D9\uC548\uC758 \uB208\uBD80\uC2E0 \uD65C\uAE30\uB294 \uC5B4\uB514\uB85C \uAC00\uACE0, \uC5B4\uAE68\uAC00 \uD798\uC5C6\uC774 \uCC98\uC838 \uC788\uC5C8\uB2E4."
    - "[N] \uC785\uC220 \uC0AC\uC774\uB85C \uC544\uC8FC \uC791\uACE0 \uC11C\uAE00\uD508 \uD55C\uC228 \uD558\uB098\uAC00 \uC0C8\uC5B4 \uB098\uC654\uB2E4."
    - '[CG_OFF]'
    - "[N] \uBC1C\uC18C\uB9AC\uC5D0 \uB180\uB780 \uADF8\uB140\uAC00 \uD654\uB4E4\uC9DD \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC557\u2026\u2026 \uC815\uC6D0\uC0AC? \uC5B8\uC81C\uBD80\uD130 \uAC70\uAE30 \uC788\uC5C8\uC5B4?"
    - "[N] \uC11C\uB458\uB7EC \uC120\uAE00\uB77C\uC2A4\uB97C \uACE0\uCCD0 \uC4F0\uBA70, \uADF8\uB140\uB294 \uC5B8\uC81C \uADF8\uB7AC\uB0D0\uB294 \uB4EF \uD638\uD0D5\uD558\uAC8C \uC6C3\uC5B4 \uBCF4\uC600\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC544\uD558\uD558! \uBA4D\uB54C\uB9AC\uB2E4 \uB531 \uAC78\uB838\uB124! \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C, \uBC30\uAC00 \uC880 \uACE0\uD320\uB098 \uBD10!"
    - "[C:\uD574\uBC14\uB77C\uAE30] \uB09C \uD574\uBC14\uB77C\uAE30\uC796\uC544! \uD480 \uC8FD\uC5B4 \uC788\uC744 \uD2C8\uC774 \uC5B4\uB514 \uC788\uC5B4?"
    - '[EXIT_C]'
    - "[N] \uADF8\uB140\uB294 \uACFC\uC7A5\uB418\uAC8C \uC190\uC744 \uD754\uB4E4\uBA70 \uB3CC\uC544\uC130\uB2E4."
    - "[N] \uD558\uC9C0\uB9CC \uADF8 \uB4B7\uBAA8\uC2B5\uC5D0 \uB4DC\uB9AC\uC6B4 \uAE34 \uADF8\uB9BC\uC790\uAC00, \uC5B4\uCA50\uC9C0 \uBAB9\uC2DC\uB3C4 \uC678\uB85C\uC6CC \uBCF4\uC600\uB2E4."
  - unlockBondLevel: 2
    title: "\uD0DC\uC591\uC774 \uC9C0\uACE0 \uB098\uBA74"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uB2A6\uC740 \uBC24, \uB0AE\uC5D0 \uC815\uC6D0\uC5D0 \uB450\uACE0 \uC628 \uBB3C\uBFCC\uB9AC\uAC1C\uB97C \uCC3E\uC73C\uB7EC \uB098\uC654\uC744 \uB54C\uC600\uB2E4."
    - "[N] \uB2EC\uBE5B\uB9CC \uD478\uB974\uAC8C \uB0B4\uB9AC\uC549\uC740 \uACE0\uC694\uD55C \uC815\uC6D0 \uAD6C\uC11D\uC5D0\uC11C, \uC5B5\uB20C\uB9B0 \uD750\uB290\uB08C \uC18C\uB9AC\uAC00 \uB4E4\uB824\uC654\uB2E4."
    - "[ENTER_C:\uD574\uBC14\uB77C\uAE30]"
    - "[N] \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uC790, \uB0AE\uC5D0\uB294 \uB204\uAD6C\uBCF4\uB2E4 \uAF3F\uAF3F\uD558\uB358 \uD574\uBC14\uB77C\uAE30\uAC00 \uC6C5\uD06C\uB824 \uC549\uC544 \uC788\uC5C8\uB2E4."
    - "[N] \uBC00\uC9DA\uBAA8\uC790\uB294 \uBC14\uB2E5\uC5D0 \uB4B9\uAD74\uACE0 \uC788\uC5C8\uACE0, \uADF8\uB140\uB294 \uBB34\uB98E\uC5D0 \uC5BC\uAD74\uC744 \uD30C\uBB3B\uC740 \uCC44 \uB5A8\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uD750\uC73D\u2026\u2026 \uD751\u2026\u2026"
    - "[N] \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB2E4\uAC00\uAC00 \uADF8\uB140\uC758 \uC774\uB984\uC744 \uBD88\uB800\uB2E4."
    - "[N] \uD760\uCE6B \uB180\uB780 \uADF8\uB140\uAC00 \uC816\uC740 \uC5BC\uAD74\uC744 \uB4E4\uC5C8\uB2E4\uAC00, \uB098\uB97C \uD655\uC778\uD558\uC790 \uC0AC\uC0C9\uC774 \uB418\uC5B4 \uB208\uBB3C\uC744 \uD6D4\uCCE4\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC815, \uC815\uC6D0\uC0AC\u2026\u2026?! \uC65C \uC548 \uC790\uACE0\u2026\u2026!"
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC544, \uC774\uAC70? \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C! \uADF8\uB0E5, \uBC24\uC5D0\uB294 \uD574\uAC00 \uC548 \uB728\uB2C8\uAE4C \uB208\uC774 \uC880 \uC2DC\uB824\uC11C\u2026\u2026!"
    - "[N] \uB610\uB2E4\uC2DC \uC529\uC529\uD55C \uCC99 \uAC70\uC9D3\uB9D0\uC744 \uD558\uB824\uB294 \uADF8\uB140\uC758 \uC5B4\uAE68\uC5D0, \uB098\uB294 \uC785\uACE0 \uC788\uB358 \uAC89\uC637\uC744 \uAC00\uB9CC\uD788 \uB36E\uC5B4\uC8FC\uC5C8\uB2E4."
    - "[N] \uADF8\uB9AC\uACE0 \uACC1\uC5D0 \uB098\uB780\uD788 \uCABC\uADF8\uB9AC\uACE0 \uC549\uC544, \uADF8\uB140\uC758 \uCC28\uAC00\uC6B4 \uC190\uC744 \uAF2D \uC950\uC5C8\uB2E4."
    - "[N] \uD56D\uC0C1 \uC5B5\uC9C0\uB85C \uC6C3\uC9C0 \uC54A\uC544\uB3C4 \uB41C\uB2E4\uACE0. \uD798\uB4E4 \uB550 \uC5BC\uB9C8\uB4E0\uC9C0 \uB0B4 \uC55E\uC5D0\uC11C \uC6B8\uC5B4\uB3C4 \uB41C\uB2E4\uACE0."
    - '[CG:sunflower_02_night_tears]'
    - "[N] \uADF8 \uC21C\uAC04, \uADF8\uB140\uC758 \uC5BC\uAD74\uC5D0\uC11C \uAC15\uD55C \uCC99\uD558\uB358 \uAC00\uBA74\uC774 \uC644\uC804\uD788 \uBB34\uB108\uC838 \uB0B4\uB838\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC73C\uC559\u2026\u2026 \uC815\uC6D0\uC0AC\u2026\u2026!"
    - "[N] \uADF8\uB140\uB294 \uB0B4 \uD488\uC73C\uB85C \uC640\uB77D \uBB34\uB108\uC9C0\uB4EF \uC548\uACA8\uB4E4\uBA70, \uB0B4 \uC154\uCE20\uAE43\uC744 \uAF49 \uC950\uC5B4 \uC7A1\uC558\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uB9E8\uB0A0 \uBC1D\uC740 \uCC99\uD558\uB294 \uAC70\u2026\u2026 \uC0AC\uC2E4 \uB108\uBB34 \uBB34\uC12D\uACE0 \uC678\uB85C\uC6E0\uC5B4\u2026\u2026!"
    - "[C:\uD574\uBC14\uB77C\uAE30] \uD574\uBC14\uB77C\uAE30\uB2C8\uAE4C, \uBC1D\uC9C0 \uC54A\uC73C\uBA74 \uC544\uBB34\uB3C4 \uB0A0 \uC548 \uC88B\uC544\uD574 \uC904\uAE4C \uBD10\u2026\u2026!"
    - "[C:\uD574\uBC14\uB77C\uAE30] \uB098\uB3C4\u2026\u2026 \uB098\uB3C4 \uB204\uAD70\uAC00\uD55C\uD14C \uC548\uACA8\uC11C \uC5B4\uB9AC\uAD11\uBD80\uB9AC\uACE0 \uC2F6\uC5C8\uB2E8 \uB9D0\uC774\uC57C\u2026\u2026!"
    - '[CG_OFF]'
    - "[N] \uADF8\uB140\uB294 \uC5B4\uB9B0\uC544\uC774\uCC98\uB7FC \uC11C\uB7FD\uAC8C \uBAA9 \uB193\uC544 \uC6B8\uC5C8\uB2E4."
    - "[N] \uD587\uC0B4\uC744 \uD5A5\uD574 \uAF3F\uAF3F\uC774 \uC11C\uB290\uB77C \uC9C0\uCCD0\uBC84\uB9B0 \uADF8\uB140\uB97C, \uB098\uB294 \uBC24\uC0C8\uB3C4\uB85D \uD488\uC5D0 \uAF2D \uC548\uC544 \uB2EC\uB798\uC8FC\uC5C8\uB2E4."
    - '[EXIT_C]'
    - "[N] \uC11C\uB298\uD55C \uBC24\uACF5\uAE30 \uC18D\uC5D0\uC11C\uB3C4, \uC11C\uB85C\uB97C \uB9DE\uB304 \uD488\uC740 \uB354\uC5C6\uC774 \uB530\uC2A4\uD588\uB2E4."
  - unlockBondLevel: 3
    title: "\uB0B4 \uC720\uC77C\uD55C \uD0DC\uC591"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uB2E4\uC74C \uB0A0, \uAD6C\uB984 \uD55C \uC810 \uC5C6\uC774 \uB208\uBD80\uC2E0 \uD478\uB978 \uD558\uB298 \uC544\uB798 \uC815\uC6D0\uC774 \uD669\uAE08\uBE5B\uC73C\uB85C \uBB3C\uB4E4\uC5C8\uB2E4."
    - "[N] \uC800 \uBA40\uB9AC\uC11C \uBC00\uC9DA\uBAA8\uC790\uB97C \uC4F4 \uADF8\uB140\uAC00, \uC774\uC804\uACFC\uB294 \uC804\uD600 \uB2E4\uB978 \uBD80\uB4DC\uB7EC\uC6B4 \uBBF8\uC18C\uB97C \uB760\uBA70 \uAC78\uC5B4\uC654\uB2E4."
    - "[ENTER_C:\uD574\uBC14\uB77C\uAE30]"
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC548\uB155, \uB098\uC758 \uC815\uC6D0\uC0AC."
    - "[N] \uACFC\uC7A5\uB41C \uC529\uC529\uD568\uC774 \uC544\uB2CC, \uAC00\uC2B4\uC18D \uAE4A\uC740 \uACF3\uC5D0\uC11C \uC6B0\uB7EC\uB098\uC624\uB294 \uD3B8\uC548\uD558\uACE0 \uB2E4\uC815\uD55C \uBAA9\uC18C\uB9AC\uC600\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC5B4\uC82F\uBC24\uC5D4\u2026\u2026 \uAF34\uC0AC\uB0A9\uAC8C \uC6B8\uC5B4\uC11C \uBBF8\uC548\uD574."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uD558\uC9C0\uB9CC \uB124 \uD488\uC5D0 \uC548\uACA8\uC11C \uD391\uD391 \uC6B8\uACE0 \uB098\uB2C8\uAE4C, \uB9C8\uC74C\uC18D \uBA39\uAD6C\uB984\uC774 \uC2F9 \uAC77\uD78C \uAC70 \uC788\uC9C0?"
    - "[N] \uADF8\uB140\uB294 \uC0B4\uD3EC\uC2DC \uB0B4 \uACC1\uC5D0 \uB2E4\uAC00\uC640 \uC549\uB354\uB2C8, \uD6CC\uB7EC\uB369 \uC790\uC2E0\uC758 \uCEE4\uB2E4\uB780 \uBC00\uC9DA\uBAA8\uC790\uB97C \uBC97\uC5C8\uB2E4."
    - '[CG:sunflower_03_sunshine_kiss]'
    - "[N] \uD22D, \uD558\uACE0 \uB0B4 \uBA38\uB9AC \uC704\uC5D0 \uADF8\uB140\uC758 \uBC00\uC9DA\uBAA8\uC790\uAC00 \uC50C\uC6CC\uC84C\uB2E4."
    - "[N] \uADF8\uB9AC\uACE0 \uBAA8\uC790 \uCC59 \uADF8\uB298 \uC544\uB798\uB85C, \uBEA8\uC744 \uBC1C\uAC1B\uAC8C \uBD89\uD78C \uADF8\uB140\uC758 \uC5BC\uAD74\uC774 \uCF54\uC55E\uAE4C\uC9C0 \uC465 \uB2E4\uAC00\uC654\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uC138\uC0C1 \uC0AC\uB78C\uB4E4\uC740 \uB2E4\uB4E4 \uADF8\uB7EC\uC796\uC544. \uD574\uBC14\uB77C\uAE30\uB294 \uD558\uB298\uC5D0 \uB72C \uD0DC\uC591\uB9CC \uBCF8\uB2E4\uACE0."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uADFC\uB370\u2026\u2026 \uADF8\uAC70 \uB2E4 \uC5C9\uD130\uB9AC\uC57C."
    - "[N] \uD638\uBC15\uC0C9 \uB208\uB3D9\uC790\uC5D0 \uB0B4 \uC5BC\uAD74\uC774 \uC628\uC804\uD788 \uAC00\uB4DD \uCC28 \uC788\uC5C8\uB2E4."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uB0B4 \uC9C4\uC9DC \uD0DC\uC591\uC740 \uC800 \uD558\uB298 \uB192\uC740 \uACF3\uC5D0 \uC788\uB294 \uAC8C \uC544\uB2C8\uC57C."
    - "[C:\uD574\uBC14\uB77C\uAE30] \uBC24\uC5D0\uB3C4 \uB0A0 \uD63C\uC790 \uB450\uC9C0 \uC54A\uACE0, \uB0B4 \uB208\uBB3C\uC744 \uB2E6\uC544\uC8FC\uB358\u2026\u2026 \uBC14\uB85C \uB108\uC57C."
