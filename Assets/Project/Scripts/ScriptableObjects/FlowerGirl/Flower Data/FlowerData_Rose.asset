    - "[C:\uC7A5\uBBF8] \uC0C1\uCC98\uB294\u2026\u2026 \uC774\uC81C \uAD1C\uCC2E\uC73C\uC2E0\uAC00\uC694?"
    - "[N] \uB0B4 \uC190\uBC14\uB2E5\uC758 \uD749\uD130\uB97C \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC5B4\uB8E8\uB9CC\uC9C0\uB294 \uADF8\uB140\uC758 \uC190\uAE38\uC740, \uAE43\uD138\uBCF4\uB2E4 \uBD80\uB4DC\uB7EC\uC6E0\uB2E4."
    - "[C:\uC7A5\uBBF8] \uB2F9\uC2E0\uC758 \uD53C\uAC00 \uC81C \uAC00\uC2DC\uC5D0 \uB2FF\uC558\uC744 \uB54C, \uBE44\uB85C\uC18C \uAE68\uB2EC\uC558\uC5B4\uC694."
    - "[C:\uC7A5\uBBF8] \uC774 \uAC00\uC2DC\uB294 \uB098\uB97C \uC9C0\uD0A4\uAE30 \uC704\uD55C \uBB34\uAE30\uAC00 \uC544\uB2C8\uB77C\u2026\u2026"
    - "[C:\uC7A5\uBBF8] \uB0B4 \uC544\uD514\uAE4C\uC9C0 \uC628\uC804\uD788 \uC548\uC544\uC904 \uB2E8 \uD55C \uC0AC\uB78C\uC744 \uC54C\uC544\uBCF4\uAE30 \uC704\uD55C \uC2DC\uD5D8\uC774\uC5C8\uB2E4\uB294 \uAC83\uC744."
    - '[CG:rose_03_embrace_devotion]'
    - "[N] \uC5EC\uC778\uC774 \uB450 \uD314\uC744 \uBC8C\uB824 \uB098\uB97C \uC628\uBAB8\uC73C\uB85C \uAC10\uC2F8 \uC548\uC558\uB2E4."
    - "[N] \uCC0C\uB974\uB294 \uAC00\uC2DC\uB294 \uB2E8 \uD558\uB098\uB3C4 \uC5C6\uC5C8\uB2E4. \uC624\uC9C1 \uBE44\uB2E8\uACB0\uCC98\uB7FC \uBD80\uB4DC\uB7FD\uACE0 \uB530\uC2A4\uD55C \uBD89\uC740 \uAF43\uC78E\uBFD0\uC774\uC5C8\uB2E4."
    - "[C:\uC7A5\uBBF8] \uC774\uC81C \uB2F9\uC2E0\uC744 \uB2E4\uCE58\uAC8C \uD560 \uAC00\uC2DC\uB294 \uC81C\uAC8C \uB2E8 \uD558\uB098\uB3C4 \uB0A8\uC544\uC788\uC9C0 \uC54A\uC544\uC694."
    - "[C:\uC7A5\uBBF8] \uC81C \uBAA8\uB4E0 \uC544\uB984\uB2E4\uC6C0\uB3C4, \uB9E4\uD639\uB3C4, \uD53C\uC640 \uC228\uACB0\uAE4C\uC9C0\uB3C4\u2026\u2026 \uC804\uBD80 \uB2F9\uC2E0\uC758 \uAC83\uC774\uC5D0\uC694."
