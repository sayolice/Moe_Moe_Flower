  memorialEntries:
  - unlockBondLevel: 1
    title: "\uBD89\uC740 \uC5EC\uC655\uACFC \uB0A0\uCE74\uB85C\uC6B4 \uAC00\uC2DC"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uC815\uC6D0 \uD55C\uD3B8\uC5D0 \uC555\uB3C4\uC801\uC778 \uAE30\uD488\uC744 \uBF50\uB0B4\uB294 \uBD89\uC740 \uAF43\uC774 \uD53C\uC5B4\uB0AC\uB2E4."
    - "[N] \uD654\uB824\uD558\uACE0 \uC9D9\uC740 \uBD89\uC740\uBE5B. \uD558\uC9C0\uB9CC \uADF8 \uC904\uAE30\uC5D0\uB294 \uC190\uB300\uAE30 \uBB34\uC11C\uC6B8 \uB9CC\uD07C \uB0A0\uCE74\uB85C\uC6B4 \uAC00\uC2DC\uAC00 \uBE7D\uBE7D\uD588\uB2E4."
    - "[ENTER_C:\uC7A5\uBBF8]"
    - "[C:\uC7A5\uBBF8] \uC5B4\uBA38\u2026\u2026 \uC0C8\uB85C\uC6B4 \uC815\uC6D0\uC0AC\uB2D8\uC774\uC2E0\uAC00\uC694?"
    - "[N] \uBD89\uC740 \uB4DC\uB808\uC2A4\uB97C \uC6B0\uC544\uD558\uAC8C \uC5EC\uBBFC \uC5EC\uC778\uC774, \uD131\uC744 \uC0B4\uC9DD \uAD38 \uCC44 \uB098\uB97C \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    - "[C:\uC7A5\uBBF8] \uD6C4\uD6C4, \uB208\uC744 \uB5BC\uC9C0 \uBABB\uD558\uC2DC\uB294\uAD70\uC694. \uC81C \uC544\uB984\uB2E4\uC6C0\uC5D0 \uCDE8\uD558\uC2E0 \uAC74\uAC00\uC694?"
    - "[N] \uACE0\uD639\uC801\uC778 \uBAA9\uC18C\uB9AC\uC600\uC9C0\uB9CC, \uC5B4\uB518\uAC00 \uC5BC\uC74C\uCC98\uB7FC \uCC28\uAC00\uC6B4 \uBCBD\uC774 \uB290\uAEF4\uC84C\uB2E4."
    - "[C:\uC7A5\uBBF8] \uD558\uC9C0\uB9CC \uC870\uC2EC\uD558\uC138\uC694. \uB108\uBB34 \uAC00\uAE4C\uC774 \uB2E4\uAC00\uC624\uBA74\u2026\u2026 \uD53C\uB97C \uBCF4\uAC8C \uB420 \uD14C\uB2C8\uAE4C\uC694."
    - '[CG:rose_01_thorn_warning]'
    - "[N] \uADF8\uB140\uB294 \uB0A0\uCE74\uB85C\uC6B4 \uAC00\uC2DC\uAC00 \uB3CB\uCE5C \uC904\uAE30\uB97C \uAC00\uBCCD\uAC8C \uC4F8\uC5B4\uB0B4\uB9AC\uBA70, \uC11C\uB298\uD55C \uBBF8\uC18C\uB97C \uC9C0\uC5C8\uB2E4."
    - "[C:\uC7A5\uBBF8] \uC7A5\uBBF8\uC758 \uAC00\uC2DC\uB294 \uC7A5\uC2DD\uC774 \uC544\uB2C8\uB78D\uB2C8\uB2E4."
    - "[C:\uC7A5\uBBF8] \uD568\uBD80\uB85C \uC190\uC744 \uBED7\uC5C8\uB2E4\uAC04, \uB2F9\uC2E0\uC758 \uC5EC\uB9B0 \uC0B4\uAC17 \uB530\uC708 \uC21C\uC2DD\uAC04\uC5D0 \uCC22\uACA8 \uB098\uAC00\uACE0 \uB9D0\uC544\uC694."
    - '[CG_OFF]'
    - "[N] \uB098\uB294 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uACE0, \uAC00\uC2DC\uB97C \uC870\uC2EC\uC2A4\uB808 \uD53C\uD574 \uC5C9\uD0A8 \uC904\uAE30 \uC544\uB798\uC758 \uB9C8\uB978 \uC78E\uB4E4\uC744 \uB2E4\uB4EC\uC5B4\uC8FC\uC5C8\uB2E4."
    - "[C:\uC7A5\uBBF8] \u2026\u2026\uC5B4\uBA38?"
    - "[N] \uC5EC\uC778\uC758 \uB208\uB3D9\uC790\uC5D0 \uCC30\uB098\uC758 \uB3D9\uC694\uAC00 \uC2A4\uCCE4\uB2E4."
    - "[C:\uC7A5\uBBF8] \uAC81\uB3C4 \uC5C6\uC73C\uC2DC\uB124\uC694. \uBCF4\uD1B5 \uC0AC\uB78C\uB4E4\uC740 \uAC00\uC2DC\uB97C \uBCF4\uC790\uB9C8\uC790 \uC9C8\uAC81\uD558\uBA70 \uBB3C\uB7EC\uC11C\uB294\uB370."
    - "[C:\uC7A5\uBBF8] \uD765\uBBF8\uB86D\uB124\uC694. \uD558\uC9C0\uB9CC \uBC29\uC2EC\uD558\uC9C4 \uB9C8\uC138\uC694."
    - "[C:\uC7A5\uBBF8] \uC800\uB294 \uB2F9\uC2E0\uC774 \uC0DD\uAC01\uD558\uB294 \uAC83\uBCF4\uB2E4, \uD6E8\uC52C \uC794\uC778\uD558\uACE0 \uC544\uD508 \uAF43\uC774\uB2C8\uAE4C\uC694."
    - '[EXIT_C]'
    - "[N] \uADF8\uB140\uB294 \uCC28\uAC00\uC6B4 \uBBF8\uC18C\uB97C \uB0A8\uAE30\uACE0 \uB3CC\uC544\uC130\uC9C0\uB9CC, \uBD89\uC740 \uAF43\uC78E \uC0AC\uC774\uB85C \uC740\uC740\uD55C \uC7A5\uBBF8\uD5A5\uC774 \uC9D9\uAC8C \uBC30\uC5B4 \uB098\uC654\uB2E4."
  - unlockBondLevel: 2
    title: "\uC0C1\uCC98 \uC785\uD788\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uC11C"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uC624\uD6C4\uAC00 \uB418\uC790 \uC815\uC6D0\uC5D0 \uAC70\uC13C \uB3CC\uD48D\uC774 \uBAB0\uC544\uCCE4\uB2E4."
    - "[N] \uAC70\uC13C \uBC14\uB78C\uC5D0 \uC7A5\uBBF8\uC758 \uC904\uAE30\uAC00 \uC0AC\uB0A9\uAC8C \uD718\uCCAD\uC774\uACE0 \uC788\uC5C8\uB2E4."
    - "[ENTER_C:\uC7A5\uBBF8]"
    - "[C:\uC7A5\uBBF8] \uD06D\u2026\u2026 \uBC14\uB78C\uC774\u2026\u2026!"
    - "[N] \uAC00\uB290\uB2E4\uB780 \uC904\uAE30\uAC00 \uBD80\uB7EC\uC9C8 \uB4EF \uD718\uC5B4\uC9C0\uB294 \uAC83\uC744 \uBCF4\uACE0, \uB098\uB294 \uBCF8\uB2A5\uC801\uC73C\uB85C \uBAB8\uC744 \uB358\uC838 \uC7A5\uBBF8\uB97C \uAC10\uC2F8 \uC548\uC558\uB2E4."
    - "[N] \uD22D."
    - "[N] \uC0B4\uC744 \uD30C\uACE0\uB4DC\uB294 \uB0A0\uCE74\uB85C\uC6B4 \uD1B5\uC99D."
    - "[N] \uC5B5\uC13C \uC7A5\uBBF8 \uAC00\uC2DC\uAC00 \uB0B4 \uC190\uBC14\uB2E5\uC744 \uAE4A\uAC8C \uCC14\uB800\uACE0, \uBD89\uC740 \uD53C\uAC00 \uBC29\uC6B8\uC838 \uD759 \uC704\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
    - "[C:\uC7A5\uBBF8] \u2026\u2026!"
    - '[CG:rose_02_bleeding_thorn]'
    - "[N] \uBD89\uC740 \uD54F\uBC29\uC6B8\uC744 \uBCF8 \uC21C\uAC04, \uC5EC\uC778\uC758 \uC5BC\uAD74\uC774 \uC0C8\uD558\uC597\uAC8C \uC9C8\uB838\uB2E4."
    - "[C:\uC7A5\uBBF8] \uC65C\u2026\u2026 \uC65C \uADF8\uB7F0 \uC9D3\uC744 \uD55C \uAC70\uC608\uC694?!"
    - "[N] \uB5A8\uB9AC\uB294 \uBAA9\uC18C\uB9AC\uB85C, \uADF8\uB140\uB294 \uB0B4 \uC190\uC744 \uAC70\uCE60\uAC8C \uCCD0\uB0B4\uBA70 \uB4B7\uAC78\uC74C\uC9C8 \uCCE4\uB2E4."
    - "[C:\uC7A5\uBBF8] \uB0B4\uAC00 \uACBD\uACE0\uD588\uC796\uC544\uC694! \uB2E4\uAC00\uC624\uC9C0 \uB9D0\uB77C\uACE0, \uAC00\uC2DC\uC5D0 \uCC14\uB9B0\uB2E4\uACE0 \uBA87 \uBC88\uC774\uB098 \uB9D0\uD588\uC796\uC544\uC694!"
    - "[N] \uADF8\uB140\uC758 \uB208\uAC00\uC5D0 \uB208\uBB3C\uC774 \uC648\uCE75 \uCC28\uC62C\uB790\uB2E4."
    - "[C:\uC7A5\uBBF8] \uB2E4\uB4E4 \uADF8\uB7AC\uC5B4\u2026\u2026 \uCC98\uC74C\uC5D4 \uC608\uC058\uB2E4\uBA70 \uB9CC\uC9C0\uB824 \uD558\uB2E4\uAC00, \uD53C\uB97C \uBCF4\uBA74 \uAD34\uBB3C \uBCF4\uB4EF \uB3C4\uB9DD\uCCE4\uB2E4\uACE0!"
    - "[C:\uC7A5\uBBF8] \uB108\uB3C4\u2026\u2026 \uB108\uB3C4 \uACB0\uAD6D \uB0A0 \uC6D0\uB9DD\uD558\uBA70 \uBC84\uB9B4 \uAC70\uC796\uC544!"
    - '[CG_OFF]'
    - "[N] \uC6B8\uBD80\uC9D6\uB294 \uADF8\uB140\uC758 \uC5B4\uAE68\uAC00 \uAC00\uB828\uD558\uAC8C \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    - "[N] \uAC00\uC2DC\uB294 \uC0C1\uB300\uB97C \uB2E4\uCE58\uAC8C \uD558\uAE30 \uC704\uD568\uC774 \uC544\uB2C8\uB77C, \uBC84\uB9BC\uBC1B\uB294 \uAC8C \uBB34\uC11C\uC6CC \uB458\uB7EC\uCE5C \uAC00\uC2DC\uBC2D\uAE38\uC774\uC5C8\uB2E4."
    - "[N] \uB098\uB294 \uD53C\uB97C \uB300\uCDA9 \uB2E6\uC544\uB0B8 \uC190\uC73C\uB85C, \uB9DD\uC124\uC784 \uC5C6\uC774 \uADF8\uB140\uC758 \uCC28\uAC00\uC6B4 \uBEA8\uC744 \uAC10\uC2F8 \uC950\uC5C8\uB2E4."
    - "[N] \uC870\uAE08\uB3C4 \uC544\uD504\uC9C0 \uC54A\uB2E4\uACE0. \uB110 \uC9C0\uCF1C\uB0BC \uC218\uB9CC \uC788\uB2E4\uBA74 \uD53C \uB530\uC708 \uC5BC\uB9C8\uB4E0\uC9C0 \uD758\uB824\uB3C4 \uC88B\uB2E4\uACE0."
    - "[C:\uC7A5\uBBF8] \uC544\u2026\u2026 \uC544\uC544\u2026\u2026 \uAC70\uC9D3\uB9D0\u2026\u2026"
    - "[N] \uC5EC\uC778\uC740 \uCC38\uC9C0 \uBABB\uD558\uACE0 \uB0B4 \uAC00\uC2B4\uD30D\uC5D0 \uC774\uB9C8\uB97C \uBB3B\uC740 \uCC44, \uC544\uC774\uCC98\uB7FC \uC18C\uB9AC \uB0B4\uC5B4 \uC6B8\uAE30 \uC2DC\uC791\uD588\uB2E4."
    - "[C:\uC7A5\uBBF8] \uBC14\uBCF4\u2026\u2026 \uC9C4\uC9DC \uBC14\uBCF4 \uAC19\uC740 \uC0AC\uB78C\u2026\u2026"
    - '[EXIT_C]'
    - "[N] \uBE44\uBC14\uB78C\uC774 \uBA4E\uC744 \uB54C\uAE4C\uC9C0, \uB098\uB294 \uD53C \uBB3B\uC740 \uC190\uC73C\uB85C \uB5A8\uB9AC\uB294 \uC7A5\uBBF8\uB97C \uAF2D \uC548\uC544\uC8FC\uC5C8\uB2E4."
  - unlockBondLevel: 3
    title: "\uAC00\uC2DC \uC5C6\uB294 \uD488\uC5D0\uC11C"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uBA70\uCE60 \uD6C4, \uC815\uC6D0\uC5D0 \uC130\uC744 \uB54C \uBBFF\uC744 \uC218 \uC5C6\uB294 \uAD11\uACBD\uC774 \uD3BC\uCCD0\uC84C\uB2E4."
    - "[N] \uC7A5\uBBF8 \uC904\uAE30\uC5D0 \uB3CB\uC544 \uC788\uB358 \uB0A0\uCE74\uB86D\uB358 \uAC00\uC2DC\uB4E4\uC774, \uAE30\uC801\uCC98\uB7FC \uC804\uBD80 \uBD80\uB4DC\uB7FD\uAC8C \uB204\uC6CC \uC788\uC5C8\uB2E4."
