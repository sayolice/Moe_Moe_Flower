  passives:
  - passiveId: pansy_auto_affection
    displayName: "\uD640\uB85C \uD53C\uC5B4\uB098\uB294 \uB9C8\uC74C"
    description: "\uBBF8\uAC1C\uD654\uD55C \uAF43\uC758 \uC790\uB3D9 \uC560\uC815 +0.25/s"
    effectType: 9
