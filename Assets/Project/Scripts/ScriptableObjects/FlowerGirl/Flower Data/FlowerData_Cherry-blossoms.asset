  memorialEntries:
  - unlockBondLevel: 1
    title: "\uBD04\uBC14\uB78C\uC774 \uBD80\uB974\uB294 \uC18C\uB9AC"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] 1,700,000,000\uACE8\uB4DC\uC758 \uAE30\uC801\uC774 \uC815\uC6D0\uC5D0 \uB2FF\uB294 \uC21C\uAC04, \uD654\uB2E8 \uC804\uCCB4\uAC00 \uB208\uC774 \uC2DC\uB9B4 \uC815\uB3C4\uC758 \uBD84\uD64D\uBE5B \uAF43\uBE44\uB85C \uB4A4\uB36E\uC600\uB2E4."
    - "[ENTER_C:\uBC9A\uAF43]"
    - "[N] \uBC9A\uAF43 \uAC00\uC9C0 \uBE44\uB140\uB97C \uAF42\uC740 \uC5F0\uBD84\uD64D \uD2B8\uC708\uD14C\uC77C\uC758 \uC18C\uB140\uAC00, \uC0AC\uBFD0\uC0AC\uBFD0 \uCDA4\uCD94\uB4EF \uAF43\uC78E \uC0AC\uC774\uB97C \uAC70\uB2D0\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uBC9A\uAF43] \uC5B4\uC11C \uC640\uC694\u2026\u2026 \uB098\uC758 \uB2E4\uC815\uD55C \uC815\uC6D0\uC0AC\uB2D8."
    - "[N] \uBD80\uB4DC\uB7FD\uAC8C \uACB9\uCCD0\uC9C4 \uBD84\uD64D\uBE5B \uAF43\uC78E \uB4DC\uB808\uC2A4\uB97C \uB098\uBD80\uB07C\uBA70, \uADF8\uB140\uAC00 \uC628\uD654\uD55C \uBBF8\uC18C\uB85C \uB098\uB97C \uB9DE\uC774\uD588\uB2E4."
    - "[C:\uBC9A\uAF43] \uB4DC\uB514\uC5B4 \uC800\uB97C \uAE68\uC6CC\uC8FC\uC168\uAD70\uC694. \uBD04\uBC14\uB78C\uC774 \uC18D\uC0AD\uC774\uB294 \uC18C\uB9AC\uB97C \uB4E3\uACE0 \uD55C\uB2EC\uC74C\uC5D0 \uD53C\uC5B4\uB0AC\uB2F5\uB2C8\uB2E4."
    - '[CG:cherry_01_blossom_flutter]'
    - "[N] \uADF8\uB140\uB294 \uD55C\uCABD \uC190\uBC14\uB2E5\uC744 \uD3BC\uCCD0, \uC0B4\uB791\uC774\uB294 \uBD04\uBC14\uB78C\uC5D0 \uBD84\uD64D\uBE5B \uBC9A\uAF43\uC78E\uC744 \uB744\uC6CC \uBCF4\uB0C8\uB2E4."
    - "[N] \uC228\uC774 \uBA4E\uC744 \uB9CC\uD07C \uC544\uB984\uB2E4\uC6B4 \uC790\uD0DC\uC600\uC9C0\uB9CC, \uC5B4\uB518\uAC00 \uACE7 \uD769\uB0A0\uB824 \uC0AC\uB77C\uC838\uBC84\uB9B4 \uAC83\uB9CC \uAC19\uC740 \uBABD\uD658\uC801\uC778 \uC544\uB828\uD568\uC774 \uAE43\uB4E4\uC5B4 \uC788\uC5C8\uB2E4."
    - '[CG_OFF]'
    - "[C:\uBC9A\uAF43] \uC608\uC058\uC8E0\u2026\u2026? \uD558\uC9C0\uB9CC \uBC9A\uAF43\uC740 \uCC38 \uB367\uC5C6\uB294 \uAF43\uC774\uB78D\uB2C8\uB2E4."
    - "[C:\uBC9A\uAF43] \uC774\uB807\uAC8C \uB208\uBD80\uC2DC\uAC8C \uD53C\uC5B4\uB0AC\uB2E4\uAC00\uB3C4\u2026\u2026 \uBD04\uBC14\uB78C\uC774 \uBA87 \uBC88 \uC2A4\uCCD0 \uC9C0\uB098\uAC00\uBA74, \uAE08\uC138 \uD754\uC801\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC838 \uBC84\uB9AC\uB2C8\uAE4C\uC694."
    - "[N] \uADF8\uB140\uC758 \uAE4A\uC740 \uBD84\uD64D\uBE5B \uB208\uB3D9\uC790\uAC00, \uBA3C \uD558\uB298\uC744 \uBC14\uB77C\uBCF4\uBA70 \uC4F8\uC4F8\uD788 \uC816\uC5B4 \uB4E4\uC5C8\uB2E4."
    - '[EXIT_C]'
    - "[N] \uC190\uBC14\uB2E5 \uC704\uC5D0 \uB0B4\uB824\uC549\uC740 \uCC28\uAC00\uC6B4 \uAF43\uC78E \uD558\uB098\uAC00, \uB2E4\uAC00\uC62C \uC774\uBCC4\uC758 \uC608\uAC10\uCC98\uB7FC \uAC00\uB9CC\uD788 \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
  - unlockBondLevel: 2
    title: "\uB2E8 \uC77C\uC8FC\uC77C\uC758 \uB9CC\uAC1C"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uBA70\uCE60 \uD6C4, \uC815\uC6D0\uC5D0 \uAC70\uC13C \uBD04\uBC14\uB78C\uC774 \uBAB0\uC544\uCE58\uAE30 \uC2DC\uC791\uD588\uB2E4."
    - "[N] \uAC00\uC9C0\uB9C8\uB2E4 \uB208\uBD80\uC2DC\uAC8C \uB9E4\uB2EC\uB824 \uC788\uB358 \uAF43\uC78E\uB4E4\uC774, \uC18C\uC6A9\uB3CC\uC774\uB97C \uCE58\uBA70 \uD5C8\uACF5\uC73C\uB85C \uD769\uBFCC\uB824\uC9C0\uACE0 \uC788\uC5C8\uB2E4."
    - "[ENTER_C:\uBC9A\uAF43]"
    - "[N] \uBC9A\uB098\uBB34 \uC544\uB798 \uC11C \uC788\uB358 \uADF8\uB140\uC758 \uC5B4\uAE68\uAC00 \uAC00\uB828\uD558\uAC8C \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uBC9A\uAF43] \uC544\uC544\u2026\u2026 \uBC14\uB78C\uC774\u2026\u2026 \uC81C \uAF43\uC78E\uB4E4\uC744 \uC804\uBD80 \uB370\uB824\uAC00\uACE0 \uC788\uC5B4\uC694\u2026\u2026."
    - "[N] \uC11C\uB458\uB7EC \uB2E4\uAC00\uAC00 \uADF8\uB140\uC758 \uB5A8\uB9AC\uB294 \uC5B4\uAE68\uB97C \uAC10\uC2F8 \uC548\uC558\uB2E4."
    - '[CG:cherry_02_falling_petals]'
    - "[N] \uC3DF\uC544\uC9C0\uB294 \uAF43\uC78E \uBE44 \uC18D\uC5D0\uC11C, \uADF8\uB140\uB294 \uB208\uBB3C\uC744 \uAE00\uC37D\uC774\uBA70 \uB0B4 \uC154\uCE20\uAE43\uC744 \uD544\uC0AC\uC801\uC73C\uB85C \uBD80\uC5EC\uC7A1\uC558\uB2E4."
    - "[C:\uBC9A\uAF43] \uC2EB\uC5B4\uC694\u2026\u2026 \uC870\uAE08\uB9CC \uB354 \uB2F9\uC2E0 \uACC1\uC5D0 \uBA38\uBB3C\uACE0 \uC2F6\uC740\uB370\u2026\u2026!"
    - "[C:\uBC9A\uAF43] \uB0B4 \uB9CC\uAC1C\uB294 \uACE0\uC791 \uC77C\uC8FC\uC77C\uBFD0\uC774\uB77C\uC11C\u2026\u2026 \uB2F9\uC2E0\uC744 \uC0AC\uB791\uD558\uAE30\uC5D4 \uC2DC\uAC04\uC774 \uB108\uBB34\uB098 \uC9E7\uB2E8 \uB9D0\uC774\uC5D0\uC694\u2026\u2026!"
    - "[C:\uBC9A\uAF43] \uAC00\uC9C0\uAC00 \uB2E4 \uBE44\uC5B4\uBC84\uB9AC\uBA74\u2026\u2026 \uC808 \uC78A\uC5B4\uBC84\uB9AC\uC2E4 \uAC74\uAC00\uC694\u2026\u2026?"
    - '[CG_OFF]'
    - "[N] \uC6B8\uBA39\uC774\uB294 \uADF8\uB140\uC758 \uC190\uBC14\uB2E5 \uC704\uC5D0, \uB098\uB294 \uBC14\uB78C\uC5D0 \uD769\uB0A0\uB9AC\uB358 \uAC00\uC7A5 \uBD89\uACE0 \uC628\uC804\uD55C \uBC9A\uAF43\uC78E \uD558\uB098\uB97C \uC950\uC5EC\uC8FC\uC5C8\uB2E4."
    - "[N] \uAF43\uC78E\uC774 \uC804\uBD80 \uC838\uB3C4 \uB110 \uACB0\uCF54 \uC78A\uC9C0 \uC54A\uB294\uB2E4\uACE0. \uACC4\uC808\uC774 \uBC31 \uBC88, \uCC9C \uBC88 \uBC14\uB00C\uC5B4\uB3C4 \uB09C \uC601\uC6D0\uD788 \uC774\uACF3\uC5D0\uC11C \uB110 \uAE30\uB2E4\uB9B4 \uAC70\uB77C\uACE0."
    - "[C:\uBC9A\uAF43] \uC815\uC6D0\uC0AC\uB2D8\u2026\u2026!"
    - "[N] \uB0B4 \uC9C4\uC2EC \uC5B4\uB9B0 \uB9F9\uC138\uC5D0, \uADF8\uB140\uB294 \uC648\uCE75 \uB208\uBB3C\uC744 \uC3DF\uC544\uB0B4\uBA70 \uB0B4 \uAC00\uC2B4\uC5D0 \uC5BC\uAD74\uC744 \uBB3B\uC5C8\uB2E4."
    - '[EXIT_C]'
    - "[N] \uD769\uB0A0\uB9AC\uB294 \uAF43\uBE44 \uC18D\uC5D0\uC11C, \uC6B0\uB9AC\uB294 \uC11C\uB85C\uB97C \uBD80\uC11C\uC9C8 \uB4EF \uB04C\uC5B4\uC548\uC73C\uBA70 \uC2AC\uD514\uC744 \uC628\uAE30\uB85C \uB179\uC5EC\uB0C8\uB2E4."
  - unlockBondLevel: 3
    title: "\uB2E4\uC2DC \uBD04\uC774 \uC624\uBA74"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uB9C8\uCE68\uB0B4 \uB9C8\uC9C0\uB9C9 \uAF43\uC78E\uC774 \uD5C8\uACF5\uC73C\uB85C \uD769\uB0A0\uB9AC\uB294 \uC774\uBCC4\uC758 \uC21C\uAC04\uC774 \uCC3E\uC544\uC654\uB2E4."
    - "[ENTER_C:\uBC9A\uAF43]"
    - "[N] \uD558\uC9C0\uB9CC \uADF8\uB140\uC758 \uC5BC\uAD74\uC5D0\uB294 \uB354 \uC774\uC0C1 \uC2AC\uD514\uC774\uB098 \uB450\uB824\uC6C0\uC758 \uADF8\uB298 \uB530\uC708 \uB0A8\uC544\uC788\uC9C0 \uC54A\uC558\uB2E4."
    - "[C:\uBC9A\uAF43] \uD6C4\uD6C4\u2026\u2026 \uACE0\uB9C8\uC6CC\uC694, \uB098\uC758 \uC601\uC6D0\uD55C \uC0AC\uB78C."
    - "[N] \uADF8\uB140\uB294 \uD55C \uAC78\uC74C \uB2E4\uAC00\uC640, \uB0B4 \uBAA9\uB35C\uBBF8\uB97C \uBD80\uB4DC\uB7FD\uAC8C \uAC10\uC2F8 \uC950\uC5C8\uB2E4."
    - '[CG:cherry_03_spring_reunion]'
    - "[N] \uC628 \uD558\uB298\uC744 \uB4A4\uB36E\uC740 \uD669\uD640\uD55C \uBC9A\uAF43\uBE44 \uC544\uB798, \uADF8\uB140\uC758 \uB530\uB73B\uD558\uACE0 \uB2EC\uCF64\uD55C \uC785\uC220\uC774 \uB0B4 \uC785\uC220\uC5D0 \uD3EC\uAC1C\uC84C\uB2E4."
    - "[N] \uAF43\uC78E\uC758 \uD5A5\uAE30\uC640 \uB208\uBB3C\uC758 \uC628\uAE30\uAC00 \uC11E\uC5EC, \uC601\uC6D0\uD788 \uC78A\uD788\uC9C0 \uC54A\uC744 \uCC2C\uB780\uD55C \uAE30\uC801\uC758 \uD0A4\uC2A4\uAC00 \uB418\uC5C8\uB2E4."
    - "[C:\uBC9A\uAF43] \uC2AC\uD37C\uD558\uC9C0 \uB9C8\uC138\uC694. \uBC9A\uAF43\uC758 \uB099\uD654\uB294 \uB05D\uC774 \uC544\uB2C8\uB77C, \uB2E4\uC2DC \uCC3E\uC544\uC62C \uC0C8\uB85C\uC6B4 \uBD04\uC758 \uC57D\uC18D\uC774\uB2C8\uAE4C\uC694."
    - "[C:\uBC9A\uAF43] \uACA8\uC6B8\uC774 \uC9C0\uB098\uACE0 \uCCAB \uBD04\uBC14\uB78C\uC774 \uBD88\uC5B4\uC624\uB294 \uB0A0\u2026\u2026 \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uB208\uBD80\uC2E0 \uAF43\uBE44\uAC00 \uB418\uC5B4 \uB2F9\uC2E0\uC744 \uCC3E\uC544\uC62C\uAC8C\uC694."
    - "[N] \uC0B4\uD3EC\uC2DC \uBBF8\uC18C \uC9C0\uC740 \uADF8\uB140\uAC00, \uAF43\uC78E\uACFC \uD568\uAED8 \uBD80\uB4DC\uB7FD\uAC8C \uD769\uB0A0\uB9AC\uBA70 \uB0B4 \uD488\uC73C\uB85C \uC2A4\uBA70\uB4E4\uC5C8\uB2E4."
    - "[C:\uBC9A\uAF43] \uC0AC\uB791\uD574\uC694\u2026\u2026 \uB098\uC758 \uC815\uC6D0\uC0AC\uB2D8. \uB0B4\uB144 \uBD04, \uB2E4\uC2DC \uB9CC\uB098\uC694."
    - '[CG_OFF]'
    - "[N] \uAC00\uC2B4\uC18D \uAE4A\uC774 \uC0C8\uACA8\uC9C4 \uADF8\uB140\uC758 \uC628\uAE30\uC640 \uD5A5\uAE30\uB294, \uCC28\uAC00\uC6B4 \uACC4\uC808\uC870\uCC28 \uB179\uC5EC\uB0BC \uC601\uC6D0\uD55C \uBD04\uC774 \uB418\uC5B4 \uB0B4 \uB9D8\uC5D0 \uC601\uC6D0\uD788 \uD53C\uC5B4\uB0AC\uB2E4."
    - '[EXIT_C]'
