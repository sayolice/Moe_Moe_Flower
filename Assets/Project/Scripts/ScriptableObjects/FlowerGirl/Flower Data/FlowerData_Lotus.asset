  passives:
  - passiveId: lotus_touch_affection
    displayName: "\uC9C4\uD759 \uC18D\uC758 \uC778\uC5F0"
    description: "\uBBF8\uAC1C\uD654 \uAF43 \uD130\uCE58 \uC2DC 6% \uD655\uB960\uB85C \uC560\uC815 1\uD68C \uCD94\uAC00"
    effectType: 8
    scope: 3
    value: 1
    chance: 0.06
  memorialEntries:
  - unlockBondLevel: 1
    title: "\uC5F0\uBABB \uC704\uC758 \uCD08\uC5F0\uD55C \uC120\uB140"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] 14,000,000,000\uACE8\uB4DC. \uC815\uC6D0\uC758 \uBAA8\uB4E0 \uAF43\uB4E4\uC774 \uB9CC\uAC1C\uD558\uACE0 \uB300\uC9C0\uAC00 \uAC00\uC7A5 \uC131\uC2A4\uB7EC\uC6B4 \uBE5B\uC73C\uB85C \uBB3C\uB4E0 \uB0A0."
    - "[N] \uC815\uC6D0 \uAC00\uC7A5 \uAE4A\uC740 \uBE44\uBC00\uC758 \uC5F0\uBABB \uD55C\uAC00\uC6B4\uB370, \uB208\uC774 \uBD80\uC2E4 \uC815\uB3C4\uB85C \uAC70\uB300\uD55C \uC5F0\uC78E\uC774 \uB5A0\uC62C\uB790\uB2E4."
    - "[ENTER_C:\uC5F0\uAF43]"
    - "[N] \uC5F0\uC78E \uC704\uC5D0 \uBE44\uC2A4\uB4EC\uD788 \uC549\uC544 \uC788\uB294 \uC5EC\uC778\uC774 \uC788\uC5C8\uB2E4. \uBC14\uB2E5\uAE4C\uC9C0 \uD750\uB974\uB294 \uB208\uBD80\uC2E0 \uBD84\uD64D\uBE5B \uBA38\uB9AC\uCE7C\uC5D0 \uC5F0\uAF43 \uD654\uAD00\uC744 \uC4F4 \uC120\uB140\uC600\uB2E4."
    - "[C:\uC5F0\uAF43] \u2026\u2026\uBA3C \uAE38\uC744 \uAC78\uC5B4\uC624\uC168\uAD70\uC694, \uC815\uC6D0\uC758 \uC8FC\uC778\uC774\uC2DC\uC5EC."
    - "[N] \uADF8\uB140\uC758 \uB9D1\uACE0 \uCCAD\uC544\uD55C \uBAA9\uC18C\uB9AC\uAC00, \uB9C8\uCE58 \uB9D1\uC740 \uBB3C\uBC29\uC6B8\uC774 \uC218\uBA74\uC5D0 \uB5A8\uC5B4\uC9C0\uB4EF \uCCAD\uBA85\uD558\uAC8C \uC6B8\uB824 \uD37C\uC84C\uB2E4."
    - '[CG:lotus_01_serene_ripples]'
    - "[N] \uD558\uC580 \uBE44\uB2E8\uC637\uC744 \uC6B0\uC544\uD558\uAC8C \uB298\uC5B4\uB728\uB9B0 \uCC44, \uADF8\uB140\uB294 \uBF40\uC580 \uBC1C\uB05D\uC744 \uC794\uC794\uD55C \uC5F0\uBABB\uBB3C\uC5D0 \uB2F4\uADF8\uACE0 \uC788\uC5C8\uB2E4."
    - "[N] \uBC1C\uB05D\uC5D0\uC11C \uD37C\uC838\uB098\uAC00\uB294 \uBB3C\uACB0\uB9C8\uB2E4, \uC138\uC0C1\uC758 \uC628\uAC16 \uD0C1\uD55C \uAC83\uB4E4\uC774 \uC815\uD654\uB418\uB4EF \uD22C\uBA85\uD558\uAC8C \uBE5B\uB0AC\uB2E4."
    - "[C:\uC5F0\uAF43] \uC218\uCC9C \uB144 \uB3D9\uC548 \uC774 \uC5F0\uBABB \uC704\uC5D0\uC11C, \uC138\uC0C1\uC758 \uC628\uAC16 \uBC88\uB1CC\uC640 \uC2AC\uD514\uC744 \uC815\uD654\uD574 \uC654\uB2F5\uB2C8\uB2E4."
    - "[C:\uC5F0\uAF43] \uB2F9\uC2E0\uC774 \uAC00\uAFBC \uC815\uC6D0\uC758 \uD5A5\uAE30\uAC00\u2026\u2026 \uC774 \uAE4A\uC740 \uC5F0\uBABB\uAE4C\uC9C0 \uB2FF\uC558\uB354\uAD70\uC694."
    - '[CG_OFF]'
    - "[N] \uC2E0\uC131\uD558\uACE0 \uC790\uC560\uB85C\uC6B4 \uBBF8\uC18C\uC600\uC9C0\uB9CC, \uADF8 \uCD08\uC5F0\uD55C \uB208\uBE5B \uB108\uBA38\uC5D0\uB294 \uC190 \uB2FF\uC744 \uC218 \uC5C6\uB294 \uC808\uB300\uC801\uC778 \uACE0\uB3C5\uC774 \uC11C\uB824 \uC788\uC5C8\uB2E4."
    - '[EXIT_C]'
    - "[N] \uC5F0\uBABB\uAC00\uC5D0 \uC11C\uC11C \uBC14\uB77C\uBCF4\uB294 \uADF8\uB140\uC758 \uBAA8\uC2B5\uC740, \uB108\uBB34\uB098 \uACE0\uACB0\uD558\uC5EC \uAC10\uD788 \uC190\uC744 \uBED7\uAE30\uC870\uCC28 \uB450\uB824\uC6B8 \uC815\uB3C4\uC600\uB2E4."
  - unlockBondLevel: 2
    title: "\uC9C4\uD759 \uC18D\uC5D0 \uAC07\uD78C \uACE0\uB3C5"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uB2EC\uBE5B\uC774 \uC5F0\uBABB\uC744 \uBE44\uCD94\uB294 \uBC24, \uB098\uB294 \uC2E0\uBC1C\uC744 \uBC97\uACE0 \uCC28\uAC00\uC6B4 \uC5F0\uBABB \uBB3C\uC18D\uC73C\uB85C \uAC78\uC5B4 \uB4E4\uC5B4\uAC14\uB2E4."
    - "[ENTER_C:\uC5F0\uAF43]"
    - "[N] \uBC1C\uBAA9\uC744 \uC801\uC2DC\uB294 \uC9C4\uD759\uD0D5\uC744 \uD5E4\uCE58\uACE0 \uB2E4\uAC00\uAC00\uC790, \uAC70\uB300\uD55C \uC5F0\uC78E \uC704\uC758 \uC5EC\uC778\uC774 \uD760\uCE6B \uB180\uB77C\uBA70 \uB098\uB97C \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    - "[C:\uC5F0\uAF43] \uC815\uC6D0\uC0AC\uB2D8\u2026\u2026? \uC5B4\uCC0C \uBB3C\uC18D\uC73C\uB85C \uB4E4\uC5B4\uC624\uC2DC\uB294 \uAC74\uAC00\uC694? \uC774\uACF3\uC740 \uD0C1\uD55C \uC9C4\uD759\uC774 \uAC00\uB4DD\uD55C \uACF3\uC785\uB2C8\uB2E4\u2026\u2026."
    - "[N] \uB300\uB2F5 \uB300\uC2E0, \uB098\uB294 \uADF8\uB140\uC758 \uACC1\uC73C\uB85C \uB2E4\uAC00\uAC00 \uC218\uBA74\uC5D0 \uC7A0\uACA8 \uC788\uB358 \uCC28\uAC00\uC6B4 \uADF8\uB140\uC758 \uBC1C\uC744 \uB0B4 \uC190\uC73C\uB85C \uC870\uC2EC\uC2A4\uB808 \uAC10\uC2F8 \uC950\uC5C8\uB2E4."
    - "[N] \uCC28\uAC11\uAC8C \uC5BC\uC5B4\uBD99\uC5B4 \uC788\uB358 \uC5EC\uC2E0\uC758 \uBC1C\uB05D\uC5D0, \uB0B4 \uCCB4\uC628\uC774 \uACE0\uC2A4\uB780\uD788 \uC804\uD574\uC84C\uB2E4."
    - "[C:\uC5F0\uAF43] \uC544\u2026\u2026 \uC74F\u2026\u2026."
    - '[CG:lotus_02_sacred_tears]'
    - "[N] \uB2FF\uB294 \uC628\uAE30\uC5D0 \uADF8\uB140\uC758 \uC5B4\uAE68\uAC00 \uD30C\uB974\uB974 \uB5A8\uB838\uB2E4. \uC5B8\uC81C\uB098 \uCD08\uC5F0\uD558\uB358 \uC5EC\uC2E0\uC758 \uB208\uAC00\uC5D0, \uC774\uC2AC \uAC19\uC740 \uB208\uBB3C\uC774 \uCC28\uC62C\uB790\uB2E4."
    - "[C:\uC5F0\uAF43] \uB2E4\uB4E4 \uC81C\uAC8C \uC18C\uC6D0\uC744 \uBE4C\uACE0, \uAE30\uB3C4\uB97C \uC62C\uB9B4 \uBFD0\u2026\u2026 \uB204\uAD6C\uB3C4 \uC81C\uAC8C \uC190\uC744 \uAC74\uB124\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    - "[C:\uC5F0\uAF43] \uC2E0\uC131\uD558\uB2E4\uB294 \uC774\uC720\uB85C, \uB354\uB7FD\uD600\uC838\uC11C\uB294 \uC548 \uB41C\uB2E4\uB294 \uC774\uC720\uB85C\u2026\u2026 \uB09C \uC601\uC6D0\uD55C \uCE68\uBB35 \uC18D\uC5D0 \uAC07\uD600 \uC788\uC5C8\uB294\uB370\u2026\u2026."
    - "[C:\uC5F0\uAF43] \uC9C4\uD759\uC744 \uBB3B\uD788\uBA74\uC11C\uAE4C\uC9C0\u2026\u2026 \uC65C \uC81C \uACC1\uC73C\uB85C \uC640\uC8FC\uC2E0 \uAC74\uAC00\uC694\u2026\u2026?"
    - '[CG_OFF]'
    - "[N] \uB2F9\uC2E0\uC740 \uBA40\uB9AC\uC11C \uAE30\uB3C4\uBC1B\uB294 \uC2E0\uC774 \uC544\uB2C8\uB77C, \uB0B4 \uC190\uC73C\uB85C \uC9C0\uCF1C\uC8FC\uACE0 \uBCF4\uB4EC\uC5B4\uC904 \uC544\uB984\uB2E4\uC6B4 \uAF43\uC774\uB77C\uACE0 \uB300\uB2F5\uD588\uB2E4."
    - "[N] \uADF8 \uB9D0\uC5D0 \uC218\uCC9C \uB144 \uB3D9\uC548 \uAC10\uC815\uC744 \uC228\uACA8\uC654\uB358 \uC5EC\uC2E0\uC774, \uC5B4\uB9B0\uC544\uC774\uCC98\uB7FC \uB0B4 \uD488\uC5D0 \uC5BC\uAD74\uC744 \uD30C\uBB3B\uC73C\uBA70 \uC624\uC5F4\uD588\uB2E4."
    - '[EXIT_C]'
    - "[N] \uCC28\uAC00\uC6B4 \uC5F0\uBABB\uC758 \uBB3C\uACB0 \uC704\uB85C, \uC11C\uB85C\uB97C \uAC10\uC2F8 \uC548\uC740 \uB450 \uC2EC\uC7A5\uC758 \uB728\uAC70\uC6B4 \uBC15\uB3D9\uB9CC\uC774 \uADD3\uAC00\uB97C \uAC00\uB4DD \uCC44\uC6E0\uB2E4."
  - unlockBondLevel: 3
    title: "\uC601\uC6D0\uD1A0\uB85D \uC815\uD654\uB420 \uC6B0\uB9AC\uC758 \uB099\uC6D0"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uC0C8\uBCBD\uC774 \uBC1D\uC544\uC624\uC790, \uAE30\uC801 \uAC19\uC740 \uAD11\uACBD\uC774 \uD3BC\uCCD0\uC84C\uB2E4."
    - "[N] \uC815\uC6D0\uC758 \uBAA8\uB4E0 \uC5F0\uBABB\uACFC \uD654\uB2E8\uC5D0\uC11C \uC218\uC5B5 \uC1A1\uC774\uC758 \uC5F0\uAF43\uC774 \uC77C\uC81C\uD788 \uD669\uAE08\uBE5B\uACFC \uBD84\uD64D\uBE5B\uC73C\uB85C \uD65C\uC9DD \uB9CC\uAC1C\uD588\uB2E4."
    - "[ENTER_C:\uC5F0\uAF43]"
    - "[N] \uAC70\uB300\uD55C \uC5F0\uC78E\uC5D0\uC11C \uB0B4\uB824\uC628 \uADF8\uB140\uAC00, \uB9C8\uCE68\uB0B4 \uC9C0\uC0C1\uC5D0 \uBC1C\uC744 \uB51B\uACE0 \uB0B4\uAC8C \uAC78\uC5B4\uC654\uB2E4."
    - "[C:\uC5F0\uAF43] \uB2F9\uC2E0\uC758 \uC0AC\uB791\uC774\u2026\u2026 \uC9C4\uD759 \uC18D\uC5D0 \uAC07\uD600 \uC788\uB358 \uC81C \uC601\uD63C\uC744 \uC628\uC804\uD788 \uAD6C\uC6D0\uD574 \uC8FC\uC168\uC2B5\uB2C8\uB2E4."
    - "[N] \uBE44\uB2E8\uACB0 \uAC19\uC740 \uAE34 \uBA38\uB9AC\uCE7C\uC774 \uBC14\uB78C\uC5D0 \uB0A0\uB9AC\uACE0, \uADF8\uB140\uC758 \uB450 \uD314\uC774 \uB0B4 \uBAA9\uC744 \uBD80\uB4DC\uB7FD\uAC8C \uAC10\uC2F8 \uC548\uC558\uB2E4."
    - '[CG:lotus_03_eternal_paradise]'
    - "[N] \uCC2C\uB780\uD55C \uC131\uD654\uAC00 \uC815\uC6D0 \uC804\uCCB4\uB97C \uB4A4\uB36E\uB294 \uAC00\uC6B4\uB370, \uC5EC\uC2E0\uC774 \uC131\uC2A4\uB7EC\uC6B4 \uBBF8\uC18C\uB85C \uB0B4 \uC785\uC220\uC5D0 \uC601\uC6D0\uC758 \uC11C\uC57D\uC744 \uB9FA\uC5C8\uB2E4."
    - "[N] \uAF43\uC78E\uBCF4\uB2E4 \uD5A5\uAE30\uB86D\uACE0, \uAE4A\uC740 \uC5F0\uBABB\uBCF4\uB2E4 \uB9D1\uC740 \uCC9C\uB144\uC758 \uC0AC\uB791\uC774 \uC628\uBAB8\uC744 \uC804\uC728\uCF00 \uD588\uB2E4."
    - "[C:\uC5F0\uAF43] \uC774\uC81C \uC804 \uD640\uB85C \uC678\uB85C\uC6B4 \uC2E0\uC73C\uB85C \uBA38\uBB3C\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    - "[C:\uC5F0\uAF43] \uB2F9\uC2E0\uC758 \uC815\uC6D0\uC744 \uC601\uC6D0\uD788 \uC2DC\uB4E4\uC9C0 \uC54A\uB294 \uC9C0\uC0C1 \uB099\uC6D0\uC73C\uB85C \uC9C0\uD0A4\uB294, \uC624\uC9C1 \uB2F9\uC2E0\uB9CC\uC758 \uBC18\uB824\uB85C \uC0B4\uC544\uAC00\uACA0\uC5B4\uC694."
    - "[N] \uADF8\uB140\uC758 \uB208\uBD80\uC2E0 \uD488 \uC548\uC5D0\uC11C, \uC6B0\uB9AC\uB294 \uC9C0\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uC544\uB984\uB2F5\uACE0 \uC644\uC804\uD55C \uAF43\uB4E4\uC758 \uB099\uC6D0\uC744 \uC644\uC131\uD588\uB2E4."
    - "[C:\uC5F0\uAF43] \uC0AC\uB791\uD569\uB2C8\uB2E4, \uB098\uC758 \uAD6C\uC6D0\uC790\u2026\u2026 \uB098\uC758 \uC601\uC6D0\uD55C \uC815\uC6D0\uC0AC\uB2D8."
    - '[CG_OFF]'
    - "[N] \uC815\uC6D0\uC758 \uBAA8\uB4E0 \uAF43\uB4E4\uC774 \uAE30\uC068\uC758 \uD5A5\uAE30\uB97C \uBFDC\uC5B4\uB0B4\uBA70, \uB450 \uC0AC\uB78C\uC758 \uC601\uC6D0\uD55C \uC0AC\uB791\uC744 \uC601\uC6D0\uD1A0\uB85D \uCD95\uBCF5\uD588\uB2E4."
    - '[EXIT_C]'
