  memorialEntries:
  - unlockBondLevel: 1
    title: "\uC0C8\uBCBD\uC744 \uAE68\uC6B0\uB294 \uD321\uD30C\uB974"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uB3D9\uC774 \uCC44 \uD2B8\uAE30\uB3C4 \uC804\uC778 \uD478\uB978 \uC0C8\uBCBD, \uC815\uC6D0\uC5D0 \uB9D1\uACE0 \uB192\uC740 \uAE08\uBE5B \uB098\uD314 \uC18C\uB9AC\uAC00 \uC6B8\uB824 \uD37C\uC84C\uB2E4."
    - "[ENTER_C:\uB098\uD314\uAF43]"
    - "[N] \uAE43\uD138 \uBAA8\uC790\uB97C \uC4F4 \uB0A8\uBCF4\uB78F\uBE5B \uD3EC\uB2C8\uD14C\uC77C\uC758 \uC18C\uB140\uAC00, \uACBD\uCF8C\uD558\uAC8C \uC81C\uC790\uB9AC\uAC78\uC74C\uC744 \uD558\uBA70 \uD2B8\uB7FC\uD3AB\uC744 \uBD88\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uBE60\uBC24- \uBE70\uBE70! \uC88B\uC740 \uC544\uCE68, \uB098\uC758 \uC815\uC6D0\uC0AC!"
    - "[N] \uD2B8\uB7FC\uD3AB\uC744 \uC954 \uCC44, \uADF8\uB140\uB294 \uD587\uC0B4\uBCF4\uB2E4 \uBA3C\uC800 \uB208\uBD80\uC2E0 \uBBF8\uC18C\uB97C \uC9C0\uC73C\uBA70 \uB0B4\uAC8C \uB6F0\uC5B4\uC654\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uB09C \uB098\uD314\uAF43\uC774\uC57C! \uC544\uCE68\uC744 \uAE68\uC6B0\uB294 \uACE0\uC801\uB300\uC758 \uC77C\uB4F1 \uB098\uD314\uC218\uC9C0!"
    - "[C:\uB098\uD314\uAF43] \uD574\uB2D8\uBCF4\uB2E4 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC11C \uB2F9\uC2E0\uC744 \uAE30\uB2E4\uB838\uC5B4! \uC624\uB298 \uD558\uB8E8\uB3C4 \uD798\uCC28\uAC8C \uB2EC\uB824\uBCF4\uB294 \uAC70\uC57C!"
    - '[CG:morningglory_01_dawn_trumpet]'
    - "[N] \uBEA8\uC744 \uBE75\uBE75\uD558\uAC8C \uBD80\uD480\uB9AC\uACE0 \uAE08\uBE5B \uD2B8\uB7FC\uD3AB\uC744 \uBD80\uB294 \uADF8\uB140\uC758 \uBC1C\uBC11\uC73C\uB85C, \uD478\uB978 \uB369\uAD74\uACFC \uAF43\uC78E\uB4E4\uC774 \uC74C\uD45C\uCC98\uB7FC \uCDA4\uC744 \uCD94\uC5C8\uB2E4."
    - "[N] \uC0C8\uBCBD\uC758 \uC5B4\uC2A4\uB984\uC744 \uB2E8\uC228\uC5D0 \uBAB0\uC544\uB0B4\uB294 \uCC2C\uB780\uD55C \uC5D0\uB108\uC9C0\uC600\uB2E4."
    - '[CG_OFF]'
    - "[N] \uD558\uC9C0\uB9CC \uC815\uC624\uAC00 \uAC00\uAE4C\uC6CC\uC9C0\uACE0 \uD587\uC0B4\uC774 \uB728\uAC70\uC6CC\uC9C0\uC790, \uC529\uC529\uD558\uB358 \uADF8\uB140\uC758 \uAC78\uC74C\uAC78\uC774\uAC00 \uCC28\uCE30 \uBE44\uD2C0\uAC70\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uD6C4\uC544\uC554\u2026\u2026 \uC5B4\uB77C? \uC774\uC0C1\uD558\uB2E4\u2026\u2026 \uBC8C\uC368 \uB208\uAEBC\uD480\uC774\u2026\u2026 \uBB34\uAC70\uC6CC\u2026\u2026."
    - "[N] \uADF8\uB140\uB294 \uD718\uCCAD\uAC70\uB9AC\uBA70 \uD2B8\uB7FC\uD3AB\uC744 \uB5A8\uC5B4\uB728\uB9B4 \uBED4\uD588\uB2E4."
    - '[EXIT_C]'
    - "[N] \uAD73\uAC8C \uB2EB\uD600\uAC00\uB294 \uADF8\uB140\uC758 \uAF43\uC78E\uC744 \uBCF4\uBA70, \uC5B4\uB518\uAC00 \uAC00\uC2B4 \uD55C\uAD6C\uC11D\uC774 \uCC0C\uB9BF\uD558\uAC8C \uC544\uB824\uC654\uB2E4."
  - unlockBondLevel: 2
    title: "\uC815\uC624\uAC00 \uCC3E\uC544\uC624\uBA74"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uC815\uC624\uB97C \uC54C\uB9AC\uB294 \uC2DC\uACC4\uD0D1 \uC885\uC18C\uB9AC\uAC00 \uC815\uC6D0\uC5D0 \uC6B8\uB824 \uD37C\uC84C\uB2E4."
    - "[ENTER_C:\uB098\uD314\uAF43]"
    - "[N] \uD654\uB2E8\uAC00 \uBCA4\uCE58\uC5D0 \uAC00\uBCF4\uB2C8, \uB098\uD314\uAF43\uC758 \uD65C\uAE30\uCC28\uB358 \uAF43\uC78E\uB4E4\uC774 \uD798\uC5C6\uC774 \uC624\uBBC0\uB77C\uB4E4\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uC73C\uC751\u2026\u2026 \uC624\uC9C0 \uB9C8\u2026\u2026 \uC774\uB7F0 \uBAA8\uC2B5\u2026\u2026 \uBCF4\uC5EC\uC8FC\uAE30 \uC2EB\uC740\uB370\u2026\u2026."
    - "[N] \uC878\uC74C\uC5D0 \uACA8\uC6CC \uD718\uCCAD\uC774\uB294 \uADF8\uB140\uB97C \uC11C\uB458\uB7EC \uBD80\uCD95\uD588\uB2E4."
    - '[CG:morningglory_02_noon_slumber]'
    - "[N] \uD480\uB9B0 \uB208\uC73C\uB85C \uB098\uB97C \uC62C\uB824\uB2E4\uBCF4\uB294 \uADF8\uB140\uC758 \uB208\uAC00\uC5D0, \uC774\uC2AC \uAC19\uC740 \uB208\uBB3C\uC774 \uBC29\uC6B8\uBC29\uC6B8 \uB9FA\uD600 \uC788\uC5C8\uB2E4."
    - "[N] \uAC00\uB290\uB2E4\uB780 \uADF8\uB140\uC758 \uD478\uB978 \uB369\uAD74\uC774, \uB5A0\uB098\uC9C0 \uB9D0\uB77C\uB294 \uB4EF \uB0B4 \uC190\uBAA9\uC744 \uC560\uC808\uD558\uAC8C \uAC10\uC544\uC950\uC5C8\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uB09C\u2026\u2026 \uC544\uCE68\uC5D0\uB9CC \uD544 \uC218 \uC788\uB294 \uAF43\uC774\uC57C\u2026\u2026."
    - "[C:\uB098\uD314\uAF43] \uD574\uAC00 \uB192\uC774 \uB728\uBA74\u2026\u2026 \uC774\uB807\uAC8C \uC7A0\uB4E4\uC5B4\uBC84\uB824\uC11C\u2026\u2026 \uB2F9\uC2E0\uACFC \uC624\uD6C4\uC758 \uAF43\uAD6C\uACBD\uB3C4, \uBC24\uD558\uB298\uC758 \uBCC4\uB3C4 \uBCFC \uC218 \uC5C6\uC5B4\u2026\u2026."
    - "[C:\uB098\uD314\uAF43] \uC870\uAE08\uB9CC \uB354\u2026\u2026 \uB2F9\uC2E0 \uACC1\uC5D0 \uAE68\uC5B4\uC788\uACE0 \uC2F6\uC740\uB370\u2026\u2026 \uC65C \uB0B4 \uC2DC\uAC04\uC740 \uC774\uB807\uAC8C \uC9E7\uC740 \uAC78\uAE4C\u2026\u2026?"
    - '[CG_OFF]'
    - "[N] \uB5A8\uC5B4\uC9C0\uB294 \uB208\uBB3C\uBC29\uC6B8\uC774 \uB0B4 \uC190\uB4F1\uC744 \uC801\uC168\uB2E4. \uC544\uCE68\uC758 \uADF8 \uB208\uBD80\uC2E0 \uD65C\uAE30\uB294, \uC774 \uC9E7\uC740 \uC2DC\uAC04\uC744 \uC628 \uD798\uC744 \uB2E4\uD574 \uC0B4\uC544\uAC00\uAE30 \uC704\uD55C \uBAB8\uBD80\uB9BC\uC774\uC5C8\uB2E4."
    - "[N] \uB098\uB294 \uADF8\uB140\uB97C \uAC00\uB9CC\uD788 \uC548\uC544 \uBCA4\uCE58\uC5D0 \uB215\uD788\uACE0, \uC190\uBAA9\uC5D0 \uAC10\uAE34 \uD478\uB978 \uB369\uAD74\uC744 \uC18C\uC911\uD788 \uC950\uC5C8\uB2E4."
    - "[N] \uAD1C\uCC2E\uB2E4\uACE0. \uB124\uAC00 \uC7A0\uB4E0 \uB3D9\uC548\uC5D0\uB3C4 \uB09C \uC5B4\uB514 \uAC00\uC9C0 \uC54A\uACE0 \uB124 \uACC1\uC744 \uC9C0\uD0A4\uACA0\uB2E4\uACE0."
    - "[N] \uB0B4\uC77C \uC544\uCE68 \uB124\uAC00 \uB208\uC744 \uB730 \uB54C, \uAC00\uC7A5 \uBA3C\uC800 \uBCF4\uAC8C \uB420 \uC0AC\uB78C\uC740 \uBC14\uB85C \uB098\uB77C\uACE0 \uC57D\uC18D\uD588\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uD751\u2026\u2026 \uC9C4\uC9DC\uC9C0\u2026\u2026? \uAF2D\u2026\u2026 \uB0B4\uC77C \uC544\uCE68\uC5D0\uB3C4\u2026\u2026 \uB0A0 \uBCF4\uB7EC \uC640\uC918\uC57C \uD574\u2026\u2026."
    - '[EXIT_C]'
    - "[N] \uC18C\uB140\uB294 \uB0B4 \uC190\uAC00\uB77D\uC744 \uB369\uAD74\uB85C \uAF2D \uC954 \uCC44, \uD3B8\uC548\uD55C \uC228\uC18C\uB9AC\uB97C \uB0B4\uBA70 \uAE4A\uC740 \uC7A0\uC5D0 \uBE60\uC838\uB4E4\uC5C8\uB2E4."
  - unlockBondLevel: 3
    title: "\uC601\uC6D0\uD55C \uC544\uCE68\uC758 \uC11C\uC57D"
    body: 
    lines:
    - '[BG:garden_dawn]'
    - "[N] \uB2E4\uC74C \uB0A0 \uC0C8\uBCBD, \uBC24\uC0C8 \uBCA4\uCE58 \uACC1\uC744 \uC9C0\uD0A4\uACE0 \uC788\uB358 \uB0B4 \uBEA8 \uC704\uB85C \uBD80\uB4DC\uB7EC\uC6B4 \uC628\uAE30\uAC00 \uB2FF\uC558\uB2E4."
    - "[ENTER_C:\uB098\uD314\uAF43]"
    - "[N] \uBC88\uCA4D \uB208\uC744 \uB728\uC790, \uBC24\uC0C8 \uAF43\uC78E\uC744 \uB2EB\uACE0 \uC7A0\uB4E4\uC5B4 \uC788\uB358 \uB098\uD314\uAF43\uC774 \uD65C\uC9DD \uD53C\uC5B4\uB098 \uB098\uB97C \uB0B4\uB824\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uC815\uB9D0\uB85C\u2026\u2026 \uBC24\uC0C8 \uB0B4 \uACC1\uC5D0 \uC788\uC5B4 \uC92C\uAD6C\uB098\u2026\u2026!"
    - "[N] \uAC10\uACA9\uC73C\uB85C \uCC28\uC624\uB978 \uADF8\uB140\uC758 \uB208\uB3D9\uC790\uC5D0 \uB9D1\uC740 \uC544\uCE68 \uC774\uC2AC\uC774 \uBC18\uC9DD\uC600\uB2E4."
    - "[N] \uADF8\uB140\uC758 \uD478\uB978 \uB369\uAD74\uC774 \uB0B4 \uC190\uBAA9\uACFC \uC190\uAC00\uB77D\uC744 \uB530\uC2A4\uD558\uAC8C \uC5BD\uC5B4\uB9E4\uBA70 \uB2E8\uB2E8\uD55C \uB9E4\uB4ED\uC744 \uB9CC\uB4E4\uC5C8\uB2E4."
    - '[CG:morningglory_03_forever_morning]'
    - "[N] \uD2B8\uB7FC\uD3AB\uC744 \uB192\uC774 \uCE58\uCF1C\uB4E0 \uADF8\uB140\uAC00, \uC640\uB77D \uB0B4 \uBAA9\uC744 \uB04C\uC5B4\uC548\uC73C\uBA70 \uD658\uD558\uAC8C \uC18C\uB9AC\uCCE4\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uC774 \uB369\uAD74\uC740 \uB2F9\uC2E0\uACFC \uB0A0 \uC601\uC6D0\uD788 \uBB36\uC5B4\uC8FC\uB294 \uC0AC\uB791\uC758 \uACB0\uC18D\uC774\uC57C!"
    - "[C:\uB098\uD314\uAF43] \uB9E4\uC77C \uB0AE\uB9C8\uB2E4 \uB0B4\uAC00 \uC2DC\uB4E4\uACE0 \uC7A0\uB4E4\uB354\uB77C\uB3C4\u2026\u2026 \uB09C \uC870\uAE08\uB3C4 \uC2AC\uD504\uC9C0 \uC54A\uC544!"
    - "[C:\uB098\uD314\uAF43] \uC65C\uB0D0\uD558\uBA74 \uB09C \uB9E4\uC77C \uC544\uCE68\uB9C8\uB2E4, \uB2F9\uC2E0\uC744 \uAC00\uC7A5 \uBA3C\uC800 \uC0AC\uB791\uD558\uAE30 \uC704\uD574 \uB2E4\uC2DC \uD53C\uC5B4\uB0A0 \uD14C\uB2C8\uAE4C!"
    - "[N] \uADD3\uAC00\uC5D0 \uB2FF\uB294 \uADF8\uB140\uC758 \uC6C3\uC74C\uC18C\uB9AC\uC640 \uD568\uAED8, \uAE08\uBE5B \uD2B8\uB7FC\uD3AB\uC5D0\uC11C \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uCC2C\uB780\uD55C \uBAA8\uB2DD \uD321\uD30C\uB974\uAC00 \uC6B8\uB824 \uD37C\uC84C\uB2E4."
    - "[C:\uB098\uD314\uAF43] \uC88B\uC740 \uC544\uCE68, \uB098\uC758 \uC601\uC6D0\uD55C \uC815\uC6D0\uC0AC! \uC0AC\uB791\uD574, \uC624\uB298\uB3C4 \uB0B4\uC77C\uB3C4 \uC601\uC6D0\uD788!"
    - '[CG_OFF]'
    - "[N] \uC0C8\uBCBD\uC548\uAC1C\uB97C \uAC00\uB974\uACE0 \uBC88\uC838\uB098\uAC00\uB294 \uB098\uD314 \uC18C\uB9AC \uC18D\uC5D0\uC11C, \uC6B0\uB9AC\uB294 \uB9E4\uC77C \uC544\uCE68 \uC0C8\uB86D\uAC8C \uC2DC\uC791\uB420 \uC601\uC6D0\uD55C \uC0AC\uB791\uC744 \uB9F9\uC138\uD588\uB2E4."
    - '[EXIT_C]'
